module std.time
type std.time.Duration: struct Duration
type std.time.Instant: struct Instant
type std.time.UtcDateTime: struct UtcDateTime
fn std.time.time_now_millis: fn() -> int
fn std.time.time_now_secs: fn() -> int
fn std.time.sleep_ms: fn(int) -> unit
fn std.time.monotonic_millis: fn() -> int
fn std.time.monotonic_nanos: fn() -> int
