fn std.time.duration_secs: fn(int) -> Duration
fn std.time.duration_millis: fn(Duration) -> int
fn std.time.duration_secs_value: fn(Duration) -> int
fn std.time.duration_add: fn(Duration, Duration) -> Duration
fn std.time.duration_sub: fn(Duration, Duration) -> Duration
fn std.time.instant_now: fn() -> Instant
fn std.time.instant_elapsed_ms: fn(Instant) -> int
fn std.time.instant_add: fn(Instant, Duration) -> Instant
fn std.time.instant_has_elapsed: fn(Instant) -> bool
