module test;
import std.io;

struct Point {
    x: int,
    y: int,
}

impl Point {
    pub fn new(x: int, y: int) -> Point {
        Point { x: x, y: y }
    }
    pub fn show(&self) -> int {
        println(f"x={self.x} y={self.y}");
        return 0;
    }
}

pub fn main() -> int {
    let p = Point::new(10, 20);
    let _r = p.show();
    return 0;
}
