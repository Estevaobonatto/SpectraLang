module string_utils;

pub fn repeat_str(s: string, n: int) -> string {
    let out = "";
    let i = 0;
    while i < n {
        out = out + s;
        i = i + 1;
    }
    return out;
}

pub fn join_two(a: string, b: string, sep: string) -> string {
    return a + sep + b;
}

pub fn join_three(a: string, b: string, c: string, sep: string) -> string {
    return a + sep + b + sep + c;
}

pub fn shout(s: string) -> string {
    return s + "!!!";
}

pub fn greet(name: string) -> string {
    return "Hello, " + name + "!";
}

pub fn reverse_pair(a: string, b: string) -> (string, string) {
    return (b, a);
}
