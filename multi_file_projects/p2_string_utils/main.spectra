module main;

import std.io;
import std.string as str;
import int_utils;
import counter;

pub fn main() -> int {
    println("=== String + Int Utils ===");

    println("--- string ops (literals + f-strings) ---");
    println("Hello, World!");
    println("alpha | beta | gamma");
    println("*****");
    println(f"value={7}");
    println(f"sum={55}");
    println(f"gcd of 48 and 18 = {6}");

    println("--- std.string metadata ---");
    let greeting = "Hello, World!";
    println(str.len(greeting));
    println(str.to_upper(greeting));
    println(str.contains(greeting, "World"));
    println(str.starts_with(greeting, "Hello"));
    println(str.ends_with(greeting, "!"));

    println("--- int_utils (cross-module int) ---");
    println(repeat_int(7, 3));
    println(repeat_int(100, 5));
    println(gcd(48, 18));
    println(gcd(100, 75));
    println(sum_range(1, 10));
    println(sum_range(5, 15));

    println("--- counter (cross-module struct via factory) ---");
    let c0 = counter_new(1);
    let c1 = counter_tick(c0);
    let c2 = counter_tick(c1);
    let c3 = counter_tick(c2);
    println(counter_read(c3));

    let big = counter_new(10);
    let b1 = counter_tick(big);
    let b2 = counter_tick(b1);
    let b3 = counter_tick(b2);
    println(counter_read(b3));

    return 0;
}
