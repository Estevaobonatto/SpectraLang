// Public Spectra surface for Phase 22 HTTP core types.
//
// The compiler exposes these declarations as the stable `std.api.http`
// built-in module, and the native implementation is registered under the
// `spectra.api.http.*` host-call namespace.

module std.api.http

public record Request {
    public method: int,
    public path: string,
    public headers: Headers,
    public body: Body,
}

public record Response {
    public status: int,
    public headers: Headers,
    public body: Body,
}

public record Method {
    public code: int,
    public name: string,
}

public record Status {
    public code: int,
    public reason: string,
}

public record Header {
    public name: string,
    public value: string,
}

public record Headers {
    public len: int,
}

public record Cookie {
    public name: string,
    public value: string,
}

public record Body {
    public len: int,
}

// Native function declarations are represented in
// compiler/src/semantic/builtin_modules.rs until package-level native extern
// declarations become first-class syntax.
