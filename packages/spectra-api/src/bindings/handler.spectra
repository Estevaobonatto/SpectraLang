// Public Spectra surface for Phase 22 API handlers.
//
// The compiler exposes these declarations as the stable `std.api.handler`
// built-in module. Native behavior is provided by `spectra.api.handler.*`.

module std.api.handler

from std.api.http import Request, Response

public record HandlerHandle {
    public route_id: int,
}

public record AsyncHandlerHandle {
    public route_id: int,
}

public record HandlerError {
    public status: int,
    public message: string,
}

public trait IntoResponse {
    func into_response( & self) returns Response
}

public trait Handler {
    func call( & self, request: Request) returns Response
}

public trait AsyncHandler {
    async func call( & self, request: Request) returns Response
}

// Native function declarations are represented in
// compiler/src/semantic/builtin_modules.rs until package-level native extern
// declarations become first-class syntax.
