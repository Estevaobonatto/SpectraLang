// Public Spectra surface for Phase 23 API middleware.
//
// The compiler exposes these declarations as the stable `std.api.middleware`
// built-in module. Native behavior is provided by `spectra.api.middleware.*`.

module std.api.middleware

from std.api.http import Request, Response

public record MiddlewareChain {
    public middleware_count: int,
}

public record MiddlewareHandle {
    public order: int,
}

public record AsyncMiddlewareHandle {
    public order: int,
}

public record MiddlewareTrace {
    public event_count: int,
}

public trait Middleware {
    func on_request( & self, request: Request) returns Request
    func on_response( & self, response: Response) returns Response
}

public trait AsyncMiddleware {
    async func on_request( & self, request: Request) returns Request
    async func on_response( & self, response: Response) returns Response
}

// Native function declarations are represented in
// compiler/src/semantic/builtin_modules.rs until package-level native extern
// declarations become first-class syntax.
