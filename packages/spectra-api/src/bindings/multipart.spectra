// Public Spectra surface for Phase 22 multipart form parsing and uploads.
//
// The compiler exposes these declarations as the stable `std.api.multipart`
// built-in module. Native behavior is provided by `spectra.api.multipart.*`.

module std.api.multipart;

pub struct Multipart {
    pub part_count: int,
}

pub struct MultipartPart {
    pub name: string,
    pub filename: string,
    pub content_type: string,
    pub size: int,
}

// Native function declarations are represented in
// compiler/src/semantic/builtin_modules.rs until package-level native extern
// declarations become first-class syntax.
