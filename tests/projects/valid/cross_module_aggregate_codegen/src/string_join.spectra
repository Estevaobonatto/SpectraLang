module string_join

public func join(parts: [string], n: int, sep: string) returns string {
    let out = ""
    let i   = 0
    while i < n {
        if i > 0 {
            out = out + sep
        }
        out = out + parts[i]
        i = i + 1
    }
    return out
}

public func sum_ints(values: [int], n: int) returns int {
    let total = 0
    let i     = 0
    while i < n {
        total = total + values[i]
        i = i + 1
    }
    return total
}
