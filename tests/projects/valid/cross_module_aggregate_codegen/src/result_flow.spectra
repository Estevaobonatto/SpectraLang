module result_flow

public func ok_value(v: int) returns Result<int, int> {
    return Result::Ok(v)
}

public func err_value(code: int) returns Result<int, int> {
    return Result::Err(code)
}

public func consume_result(value: Result<int, int>) returns int {
    return match value {
        when Result::Ok(v) then v,
        when Result::Err(e) then e * -1
    }
}
