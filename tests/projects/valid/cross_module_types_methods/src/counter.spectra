module counter;

pub struct Counter {
    pub value: int,
    pub step: int
}

impl Counter {
    pub fn new(step: int) -> Counter {
        return Counter { value: 0, step: step };
    }

    pub fn with_value(value: int, step: int) -> Counter {
        return Counter { value: value, step: step };
    }

    pub fn tick(&self) -> Counter {
        return Counter { value: self.value + self.step, step: self.step };
    }

    pub fn read(&self) -> int {
        return self.value;
    }
}
