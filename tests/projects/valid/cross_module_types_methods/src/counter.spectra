module counter

public record Counter {
    public value: int,
    public step: int
}

impl Counter {
    public func new(step: int) returns Counter {
        return Counter { value: 0, step: step }
    }

    public func with_value(value: int, step: int) returns Counter {
        return Counter { value: value, step: step }
    }

    public func tick( & self) returns Counter {
        return Counter { value: self.value + self.step, step: self.step }
    }

    public func read( & self) returns int {
        return self.value
    }
}
