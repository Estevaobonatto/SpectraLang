module inventory

public record Item {
    public sku: string,
    public name: string,
    public price: int,
    public stock: int
}

public enum StockStatus {
    InStock,
    Low,
    OutOfStock
}

impl Item {
    public func new(sku: string, name: string, price: int, stock: int) returns Item {
        return Item { sku: sku, name: name, price: price, stock: stock }
    }

    public func value( & self) returns int {
        return self.price * self.stock
    }
}

public func classify(stock: int) returns StockStatus {
    if stock == 0 {
        return StockStatus::OutOfStock
    }
    if stock < 5 {
        return StockStatus::Low
    }
    return StockStatus::InStock
}

public func status_code(status: StockStatus) returns int {
    return match status {
        when StockStatus::InStock then 3,
        when StockStatus::Low then 1,
        when StockStatus::OutOfStock then 0
    }
}
