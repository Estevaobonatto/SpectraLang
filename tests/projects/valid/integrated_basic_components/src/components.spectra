module components

public enum Step {
    Some(int),
    Done,
}

public record Invoice {
    public subtotal: int,
    public tax: int,
}

impl Invoice {
    public func total( & self) returns int {
        return self.subtotal + self.tax
    }
}

public func next(value: int) returns Step {
    if value > 0 {
        return Step::Some(value)
    }
    return Step::Done
}

public func control_total(start: int) returns int {
    let cursor = start
    let sum    = 0

    while let Step::Some(value) = next(cursor) {
        sum = sum + value
        cursor = cursor - 1
    }

    match sum {
        when 10 then {
            return sum + 7
        }
        otherwise then {
            return sum
        }
    }
}
