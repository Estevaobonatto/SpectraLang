module traits

import components

public trait Score {
    func score( & self) returns int
}

impl Score for Invoice {
    func score( & self) returns int {
        return self.total()
    }
}

public func score_invoice<T: Score>(item: T) returns int {
    return item.score()
}

public func score_invoice_runtime(item: Invoice) returns int {
    return item.score()
}

public func apply_adjustment(value: int, f: func(int) returns int) returns int {
    return f(value)
}

public func make_shift(delta: int) returns func(int) returns int {
    let scale = 2
    return | value: int | value + delta * scale
}
