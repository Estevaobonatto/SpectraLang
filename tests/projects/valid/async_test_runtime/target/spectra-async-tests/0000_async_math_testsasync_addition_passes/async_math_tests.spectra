module async_math_tests;

import math;

#[spectra_async_test]
async fn async_addition_passes() -> int {
    let value = await ready_add(20, 22);
    if value != 42 {
        return 1;
    }
    return 0;
}

#[spectra_async_test]
async fn block_on_is_available() -> int {
    let task = ready_add(10, 32);
    let value = block_on(task);
    if value != 42 {
        return 1;
    }
    return 0;
}

fn main() -> int {
    return block_on(async_addition_passes());
}
