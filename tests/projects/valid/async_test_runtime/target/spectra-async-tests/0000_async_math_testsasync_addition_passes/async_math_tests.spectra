module async_math_tests

import math

#[spectra_async_test]
async func async_addition_passes() returns int {
    let value = await ready_add(20, 22)
    if value != 42 {
        return 1
    }
    return 0
}

#[spectra_async_test]
async func block_on_is_available() returns int {
    let task  = ready_add(10, 32)
    let value = block_on(task)
    if value != 42 {
        return 1
    }
    return 0
}

func main() returns int {
    return block_on(async_addition_passes())
}
