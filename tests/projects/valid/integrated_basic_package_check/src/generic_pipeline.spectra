module generic_pipeline

public trait Score {
    func score( & self) returns int
}

public record Sample {
    public value: int,
    public weight: int,
}

impl Score for Sample {
    func score( & self) returns int {
        return self.value + self.weight
    }
}

public func evaluate<T: Score>(item: T) returns int {
    return item.score()
}

public func evaluate_sample(item: Sample) returns int {
    return item.score()
}
