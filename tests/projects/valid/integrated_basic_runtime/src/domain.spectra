module domain

public record Account {
    public id: string,
    public balance: int,
}

public enum AccountStatus {
    Empty,
    Low,
    Funded,
}

impl Account {
    public func new(id: string, balance: int) returns Account {
        return Account { id: id, balance: balance }
    }

    public func deposit( & self, amount: int) returns Account {
        return Account { id: self.id, balance: self.balance + amount }
    }
}

public func classify(balance: int) returns AccountStatus {
    if balance == 0 {
        return AccountStatus::Empty
    }
    if balance < 10 {
        return AccountStatus::Low
    }
    return AccountStatus::Funded
}

public func status_code(status: AccountStatus) returns int {
    return match status {
        when AccountStatus::Empty then 0,
        when AccountStatus::Low then 1,
        when AccountStatus::Funded then 2
    }
}
