module control_flow

public func branch_loop_total(limit: int) returns int {
    let cursor = 0
    let total  = 0

    do {
        cursor = cursor + 1
        if not cursor == 3 {
            total = total + cursor
        }
    } while cursor < limit

    loop {
        total = total + 1
        if total >= 13 {
            break
        }
    }

    return total
}
