module model

import std.ml as ml
import std.tensor as tensor

public func model_feature_count() returns int {
    return 2
}

public func model_parameter_count() returns int {
    let model_handle = ml.module_new()
    let weight       = tensor.reshape(tensor.full_f(1, 0.5), 1, 1)
    let bias         = tensor.full_f(1, 0.0)
    ml.module_add_parameter(model_handle, weight)
    ml.module_add_parameter(model_handle, bias)
    return ml.module_parameter_count(model_handle)
}
