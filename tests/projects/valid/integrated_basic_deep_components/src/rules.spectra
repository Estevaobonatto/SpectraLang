module rules

import ledger

public trait ChargeRule {
    func charge( & self) returns int
}

public record FixedCharge {
    public base: int,
    public fee: int,
}

impl ChargeRule for FixedCharge {
    func charge( & self) returns int {
        return self.base + self.fee
    }
}

public func apply_charge(rule: FixedCharge) returns int {
    return rule.charge()
}

public func state_score(state: PaymentState) returns int {
    return match state {
        when PaymentState::Empty then 0,
        when PaymentState::Partial { due } then due,
        when PaymentState::Closed(total) then total
    }
}
