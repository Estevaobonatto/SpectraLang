module ledger

public record Invoice {
    public id: string,
    public subtotal: int,
    public paid: int,
}

public enum PaymentState {
    Empty,
    Partial { due: int },
    Closed(int),
}

impl Invoice {
    public func new(id: string, subtotal: int, paid: int) returns Invoice {
        return Invoice { id: id, subtotal: subtotal, paid: paid }
    }

    public func due( & self) returns int {
        return self.subtotal - self.paid
    }
}

public func classify(invoice: Invoice) returns PaymentState {
    let due = invoice.due()
    if due == invoice.subtotal {
        return PaymentState::Empty
    }
    if due > 0 {
        return PaymentState::Partial { due: due }
    }
    return PaymentState::Closed(invoice.subtotal)
}
