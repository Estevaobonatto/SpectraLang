module control

public enum Step {
    More(int),
    Done,
}

public func next(value: int) returns Step {
    if value > 0 {
        return Step::More(value)
    }
    return Step::Done
}

public func sum_window(start: int) returns int {
    let cursor = start
    let sum    = 0

    while let Step::More(value) = next(cursor) {
        if not value == 2 {
            sum = sum + value
        }
        cursor = cursor - 1
    }

    return sum
}
