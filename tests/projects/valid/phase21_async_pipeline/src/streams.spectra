module streams

import tasks

public async func stream_like_sum(start: int) returns int {
    let first  = await tasks::ready(start)
    let second = await tasks::ready(start + 1)
    let third  = await tasks::ready(start + 2)
    return first + second + third
}

public async func mapped_like_sum(start: int) returns int {
    let raw    = await stream_like_sum(start)
    let mapped = await tasks::ready(raw * 2)
    return mapped
}
