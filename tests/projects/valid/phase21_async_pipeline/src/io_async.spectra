module io_async

import tasks

public async func file_like_roundtrip(value: int) returns int {
    let written   = await tasks::ready(value + 1)
    let read_back = await tasks::ready(written + 1)
    return read_back
}

public async func socket_like_roundtrip(value: int) returns int {
    let sent     = await tasks::ready(value)
    let received = await tasks::ready(sent)
    return received
}

public async func channel_like_roundtrip(value: int) returns int {
    let send_status = await tasks::ready(1)
    let received    = await tasks::ready(value)
    return send_status + received
}
