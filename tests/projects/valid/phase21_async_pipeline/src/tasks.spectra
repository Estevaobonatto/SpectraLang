module tasks;

pub async fn ready(value: int) -> int {
    return value;
}

pub async fn add_pair(left: int, right: int) -> int {
    let a = await ready(left);
    let b = await ready(right);
    return a + b;
}

pub async fn choose(flag: bool, left: int, right: int) -> int {
    if flag {
        let selected = await ready(left);
        return selected;
    }
    let selected = await ready(right);
    return selected;
}
