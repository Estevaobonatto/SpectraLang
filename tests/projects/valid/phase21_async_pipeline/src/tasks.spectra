module tasks

public async func ready(value: int) returns int {
    return value
}

public async func add_pair(left: int, right: int) returns int {
    let a = await ready(left)
    let b = await ready(right)
    return a + b
}

public async func choose(flag: bool, left: int, right: int) returns int {
    if flag {
        let selected = await ready(left)
        return selected
    }
    let selected = await ready(right)
    return selected
}
