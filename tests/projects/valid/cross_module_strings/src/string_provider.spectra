module string_provider

import std.string as str

public func user_greeting(name: string) returns string {
    return "Hello, " + name
}

public func user_join(a: string, b: string, sep: string) returns string {
    return a + sep + b
}

public func user_upper(s: string) returns string {
    return str.to_upper(s)
}

public func user_lower(s: string) returns string {
    return str.to_lower(s)
}

public func user_repeat(s: string, n: int) returns string {
    return str.repeat_str(s, n)
}

public func user_replace(s: string, from_text: string, to: string) returns string {
    return str.replace(s, from_text, to)
}

public func user_reverse(s: string) returns string {
    return str.reverse_str(s)
}

public func user_trim(s: string) returns string {
    return str.trim(s)
}
