module main;

import onnx_boundary;
import rag_pipeline;
import serving_contract;

pub fn main() -> int {
    let onnx = validate_onnx_boundary();
    if onnx != 0 {
        return onnx;
    }
    let rag = validate_rag_pipeline();
    if rag != 0 {
        return rag;
    }
    return validate_serving_contract();
}
