// Negative: static tensor dimensions must match when both sides declare them.
module tensor_shape_mismatch

public func main() returns int {
    let source: Tensor<float, rank1, dim3, row_major, cpu> = [1.0, 2.0, 3.0]
    let target: Tensor<float, rank1, dim4, row_major, cpu> = source
    return 0
}
