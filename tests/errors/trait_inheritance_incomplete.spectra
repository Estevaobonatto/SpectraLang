// Teste de erro: trait inheritance incompleta
module test_error

trait Printable {
    func to_string( & self) returns int
}

trait Debug: Printable {
    func debug( & self) returns int
}

record Point {
    x: int,
    y: int
}

// Erro: implementa Debug mas não implementa to_string de Printable
impl Debug for Point {
    func debug( & self) returns int {
        self.x * self.y
    }
}

func main() returns int {
    0
}
