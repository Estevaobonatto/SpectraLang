// Negative test: metadata/lifecycle operations are not differentiable.
module diff_block_unsupported_operation

import std.tensor as tensor

public func main() returns int {
    tensor.free_all()
    tensor.set_grad_enabled( true)

    let base: Tensor<float, rank1, dim3, row_major, cpu>      = [1.0, 2.0, 3.0]
    let trainable: Tensor<float, rank1, dim3, row_major, cpu> = tensor.requires_grad(base, true)
    let loss: Tensor<float, rank0>                            = diff {
        tensor.rank(trainable)
        tensor.sum_t(tensor.mul(trainable, trainable))
    }

    tensor.free_all()
    return tensor.rank(loss)
}
