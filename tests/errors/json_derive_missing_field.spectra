module json_derive_missing_field

#[derive(Serialize, Deserialize)]
record Profile {
    #[json(rename = "user_id")]
    id: int,
    name: string,
    #[json(optional)]
    nickname: string,
}

public func main() returns int {
    let decoded: Profile = Profile::from_json("{\"user_id\":7}")
    return decoded.id
}
