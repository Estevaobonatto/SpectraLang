// Known issue tracked by R-109.
// This invalid generic program should fail in semantic analysis, but currently
// can reach codegen and fail with `Verifier errors`.
module generic_return_type_mismatch_codegen_verifier;

fn identity_as_int<T>(value: T) -> int {
    return value;
}

pub fn main() -> int {
    return identity_as_int("bad");
}
