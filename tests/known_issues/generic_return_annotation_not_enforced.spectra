// Known issue tracked by R-109.
// This program is semantically invalid but currently compiles:
// `bad<int>` returns an int value from a function declared to return string.
module generic_return_annotation_not_enforced;

fn bad<T>(value: T) -> string {
    return value;
}

pub fn main() -> int {
    let x = bad(1);
    return 0;
}
