// Teste: Código válido - sem erros semânticos
module test_valid

public func main() {
    let x      = 10
    let y      = 20
    let sum    = add(x, y)
    let result = x + y
    return
}

func add(a: int, b: int) returns int {
    return a + b
}

func multiply(a: int, b: int) returns int {
    let result = a * b
    return result
}
