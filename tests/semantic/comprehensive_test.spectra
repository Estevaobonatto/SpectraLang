// TESTE CONSOLIDADO: Todas as funcionalidades do sistema de tipos
module comprehensive_test

// ============================================
// PARTE 1: Funções com Tipos Explícitos
// ============================================

func add_integers(a: int, b: int) returns int {
    return a + b
}

func multiply_floats(x: float, y: float) returns float {
    return x * y
}

func is_positive(num: int) returns bool {
    return num > 0
}

func concat_strings(s1: string, s2: string) returns string {
    return s1
    // TODO: implementar concatenação real
}

// ============================================
// PARTE 2: Inferência de Tipos
// ============================================

public func main() {
    // Literais básicos
    let int_var    = 42
    let float_var  = 3.14
    let string_var = "Hello"
    let bool_var   = true

    // Operações aritméticas
    let sum  = 10 + 20
    let diff = 100 - 50
    let prod = 5 * 6
    let quot = 100 / 4
    let rem  = 17 % 5

    // Operações com float
    let float_sum  = 1.5 + 2.5
    let float_prod = 2.0 * 3.0

    // Comparações
    let greater   = 10 > 5
    let less      = 3 < 7
    let equal     = sum == 30
    let not_equal = diff != 100
    let gte       = 10 >= 10
    let lte       = 5 <= 10

    // Operações lógicas
    let and_op        = true and false
    let or_op         = true or false
    let complex_logic = (10 > 5) and(20 < 30)

    // ============================================
    // PARTE 3: Chamadas de Função
    // ============================================

    let result1 = add_integers(10, 20)
    let result2 = multiply_floats(2.5, 4.0)
    let result3 = is_positive(100)
    let result4 = concat_strings("Hello", "World")

    // ============================================
    // PARTE 4: Expressões Complexas
    // ============================================

    let complex1 = (10 + 5) * (20 - 8)
    let complex2 = ((100 / 4) * 3) + (50 - 10)
    let complex3 = (10 > 5) and(20 < 30) or(15 == 15)

    // ============================================
    // PARTE 5: Validações de Tipo
    // ============================================

    // Operações válidas
    let valid1 = int_var + 10
    let valid2 = float_var * 2.0
    let valid3 = bool_var and true

    // Comparações válidas
    let valid4 = int_var > 0
    let valid5 = float_var <= 5.0
    let valid6 = string_var == "Hello"

    return
}

// ============================================
// PARTE 6: Funções Auxiliares
// ============================================

func calculate_average(a: int, b: int, c: int) returns int {
    let sum = a + b + c
    let avg = sum / 3
    return avg
}

func check_range(value: int, min: int, max: int) returns bool {
    let above_min = value >= min
    let below_max = value <= max
    return above_min and below_max
}

func process_number(n: int) returns int {
    let doubled  = n * 2
    let plus_ten = doubled + 10
    return plus_ten
}
