module std_api_surface;

import {
    method_name,
    method_allows_body,
    request_new,
    request_method,
    response_new,
    response_status,
    status_class,
} from std.api.http;
import { validate, kind} from std.api.json;
import { client_config, config_mode} from std.api.tls;
import { router_new, route_count} from std.api.routing;
import { last_code} from std.api.errors;

pub fn main() -> int {
    let request        = request_new(1);
    let method         = request_method(request);
    let method_text    = method_name(method);
    let allows_body    = method_allows_body(method);
    let response       = response_new(200);
    let status_code    = response_status(response);
    let response_class = status_class(status_code);
    let payload_ok     = validate("{\"ok\": true}");
    let json_kind      = kind("{\"ok\": true}");
    let tls_config     = client_config();
    let tls_mode       = config_mode(tls_config);
    let router         = router_new();
    let routes         = route_count(router);
    let error_code     = last_code();

    return response_class + json_kind + tls_mode + routes + error_code;
}
