module stdlib_collections_hof

import std.collections as collections

public func main() returns int {
    let values = collections.list_new()
    collections.list_push(values, 1)
    collections.list_push(values, 2)
    collections.list_push(values, 3)
    collections.list_push(values, 4)

    let doubled = collections.list_map(values, | value: int | value * 2)
    if collections.list_len(doubled) != 4 or collections.list_get(doubled, 2) != 6 {
        return 1
    }

    let evens = collections.list_filter(values, | value: int | 1 - (value % 2))
    if collections.list_len(evens) != 2 or collections.list_get(evens, 0) != 2 {
        return 2
    }

    let total = collections.list_reduce(doubled, 0, | acc: int, value: int | acc + value)
    if total != 20 {
        return 3
    }

    collections.list_sort_by(values, | left: int, right: int | right - left)
    if collections.list_get(values, 0) != 4 or collections.list_get(values, 3) != 1 {
        return 4
    }

    collections.list_free(values)
    collections.list_free(doubled)
    collections.list_free(evens)
    return 0
}
