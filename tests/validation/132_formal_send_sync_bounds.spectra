module formal_send_sync_bounds

trait Worker {
    async func run( & self, input: int) returns int
}

record SendWorker {
    base: int
}

impl Worker for SendWorker {
    async func run( & self, input: int) returns int {
        return self.base + input
    }
}

async func ready(value: int) returns int {
    return value
}

func keep<T>(value: T) returns int {
    return 1
}

async func generic_send_value<T: Send>(value: T, score: int) returns int {
    let carried = value
    let waited  = await ready(score)
    return waited + keep(carried)
}

func require_sync<T: Sync>(value: T) returns int {
    return 1
}

async func drive(worker: dyn Worker + Send) returns int {
    let result = await worker.run(5)
    return result
}

func inspect(worker: dyn Worker + Send + Sync) returns int {
    return 1
}

func spawn_task<T: Send>(value: T) returns int {
    return 1
}

async func spawn_generic<T: Send>(value: T) returns int {
    return spawn_task(value)
}

async func aggregate() returns int {
    let source = SendWorker { base: 37 }
    let worker = source as dyn Worker + Send + Sync
    let first  = await drive(worker)
    let second = inspect(worker)
    let third  = spawn_task(20)
    let fourth = require_sync(10)
    return first + second + third + fourth
}

func main() returns int {
    let task = aggregate()
    return block_on(task) - 45
}
