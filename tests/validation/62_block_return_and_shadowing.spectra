// Teste 62: retorno implicito de bloco, shadowing e statement final sem valor
module block_return_and_shadowing

func classify(n: int) returns int {
    let result = {
        let n = n + 1
        if n > 5 {
            n
        } else {
            5
        }
    }

    match result {
        when 6 then {}
        otherwise then {
            return result
        }
    }

    let guard = 0
    loop {
        guard = guard + 1
        if guard == 1 {
            break
        }
    }

    return 0
}

public func main() returns int {
    return classify(5)
}
