// Extended validation: closure capture, higher-order application and folding.
module base_closure_pipeline

func apply(value: int, transform: func(int) returns int) returns int {
    return transform(value)
}

func fold_three(a: int, b: int, c: int, combine: func(int, int) returns int) returns int {
    return combine(combine(a, b), c)
}

public func main() returns int {
    let offset  = 7
    let shifted = apply(5, | x: int | x + offset)
    if shifted != 12 { return 1
    }

    let doubled = apply(9, | x: int | x * 2)
    if doubled != 18 { return 2
    }

    let sum = fold_three(2, 3, 4, | left: int, right: int | left + right)
    if sum != 9 { return 3
    }
    return 0
}
