module async_phase21_pipeline

async func fetch_piece(seed: int) returns int {
    return seed + 1
}

async func transform_piece(value: int) returns int {
    let left  = await fetch_piece(value)
    let right = await fetch_piece(left)
    return left + right
}

async func aggregate() returns int {
    let first  = await transform_piece(1)
    let second = await transform_piece(3)
    let third  = await transform_piece(5)
    return first + second + third
}

func main() returns int {
    let task = aggregate()
    return 0
}
