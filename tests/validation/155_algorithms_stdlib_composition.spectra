module algorithms_stdlib_composition

import std.math as math
import std.range
import std.string as str
import std.time

func range_sum(r: Range) returns int {
    let total = 0
    for value in r {
        total = total + value
    }
    return total
}

public func main() returns int {
    let phrase = "spectra algorithms suite"
    if str.len(phrase) != 24 {
        return 1
    }
    if not str.contains(phrase, "algorithms") {
        return 2
    }

    let numeric = math.abs(-9) + math.min(5, 3) + math.max(2, 8) + math.floor_f(3.9) as int
    if numeric != 23 {
        return 3
    }

    let r = create(3, 8, false)
    if len(r) != 5 {
        return 4
    }
    if at(r, 2) != 5 {
        return 5
    }
    if range_sum(r) != 25 {
        return 6
    }

    let before = monotonic_millis()
    let after  = monotonic_millis()
    if after < before {
        return 7
    }

    return 0
}
