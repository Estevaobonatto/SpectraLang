module http_core_types;

import {
    Request,
    Response,
    Header,
    Cookie,
    method_get,
    method_post,
    method_name,
    method_allows_body,
    request,
    request_method,
    request_path,
    response,
    response_status,
    status_created,
    status_class,
    status_reason,
    header,
    header_name,
    header_value,
    cookie,
    cookie_name,
    cookie_value,
    header_name_is_valid,
    header_value_is_valid,
} from std.api.http;

fn create_user(req: Request) -> Response {
    let method = request_method(req);
    let ok = method_allows_body(method);
    let path = request_path(req);
    let created = response(status_created());
    return created;
}

pub fn main() -> int {
    let get_code = method_get();
    let post_code = method_post();
    let post_text = method_name(post_code);
    let req = request(post_code, "/users");
    let res = create_user(req);
    let status = response_status(res);
    let status_group = status_class(status);
    let reason = status_reason(status);
    let h = header("Content-Type", "application/json");
    let h_name = header_name(h);
    let h_value = header_value(h);
    let c = cookie("session", "abc123");
    let c_name = cookie_name(c);
    let c_value = cookie_value(c);
    let valid_name = header_name_is_valid("content-type");
    let valid_value = header_value_is_valid("application/json");
    if status == 201 && status_group == 2 && get_code == 1 && post_code == 3 {
        return 0;
    }
    return 1;
}
