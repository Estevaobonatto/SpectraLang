// Teste 15: Expressões complexas
module complex_expressions

func test_complex() returns int {
    let a = 10
    let b = 5
    let c = 3

    let result     = (a + b) * c - (a / b) + (b % c)
    let comparison = (a > b) and(b > c) or(a == 10)
    let negation   = not(a < b)

    return result
}

func main() returns int {
    return test_complex()
}
