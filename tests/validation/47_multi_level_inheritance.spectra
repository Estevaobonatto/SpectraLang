// Teste de trait inheritance com múltiplos níveis
module test47

// Trait base
trait Display {
    func display( & self) returns int
}

// Trait intermediário
trait Printable: Display {
    func println( & self) returns int
}

// Trait final (herda Display via Printable)
trait Debug: Printable {
    func debug( & self) returns int
}

// Struct que implementa Debug
// Deve implementar: display (de Display), println (de Printable), debug (de Debug)
record Point {
    x: int,
    y: int
}

impl Debug for Point {
    // Implementa display (herdado de Display via Printable)
    func display( & self) returns int {
        self.x
    }

    // Implementa println (herdado de Printable)
    func println( & self) returns int {
        self.x + self.y
    }

    // Implementa debug (de Debug)
    func debug( & self) returns int {
        self.x * self.y
    }
}

func main() returns int {
    let p    = Point { x: 10, y: 20 }
    let disp = p.display()
    // 10
    let prt = p.println()
    // 30
    let dbg = p.debug()
    // 200
    disp + prt + dbg // 240
}
