// Teste 14: Múltiplas funções
module multiple_functions

func add(a: int, b: int) returns int {
    return a + b
}

func multiply(a: int, b: int) returns int {
    return a * b
}

func calculate(x: int, y: int) returns int {
    let sum  = add(x, y)
    let prod = multiply(x, y)
    return sum + prod
}

func main() returns int {
    return calculate(5, 3)
}
