// Teste de self.field access
module test40

record Point {
    x: int,
    y: int
}

impl Point {
    func get_x( & self) returns int {
        self.x // Acesso direto ao campo
    }

    func get_y( & self) returns int {
        self.y
    }

    func sum( & self) returns int {
        self.x + self.y
    }
}

func main() returns int {
    let p = Point { x: 10, y: 20 }
    let x = p.get_x()
    let y = p.get_y()
    let s = p.sum()
    x + y + s
}
