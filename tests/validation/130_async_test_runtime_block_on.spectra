module async_test_runtime_block_on

async func ready_value(value: int) returns int {
    return value + 1
}

#[spectra_async_test]
async func async_test_macro_smoke() returns int {
    let value = await ready_value(40)
    if value != 41 {
        return 1
    }
    return 0
}

func main() returns int {
    let task  = ready_value(41)
    let value = block_on(task)
    if value != 42 {
        return 1
    }
    return 0
}
