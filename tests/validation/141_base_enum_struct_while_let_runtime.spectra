module base_enum_struct_while_let_runtime

enum Counter {
    Running { current: int },
    Done,
}

func next_state(value: int) returns Counter {
    if value > 0 {
        return Counter::Running { current: value }
    }
    return Counter::Done
}

func drain(start: int) returns int {
    let cursor = start
    let sum    = 0

    while let Counter::Running { current } = next_state(cursor) {
        sum = sum + current
        cursor = cursor - 1
    }

    return sum
}

public func main() returns int {
    let total = drain(4)
    if total != 10 {
        return total
    }

    if let Counter::Running { current } = next_state(1) {
        if current != 1 {
            return current
        }
    } else {
        return 91
    }

    return 0
}
