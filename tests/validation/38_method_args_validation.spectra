// Test: Method argument validation
module method_args_test

record Calculator {
    value: int
}

impl Calculator {
    func add( & self, x: int, y: int) returns int {
        x + y
    }

    func multiply( & self, x: int) returns int {
        x * 2
    }
}

func main() returns int {
    let calc = Calculator { value: 0 }

    // Correto: 2 argumentos
    let sum = calc.add(5, 3)

    // Correto: 1 argumento
    let product = calc.multiply(7)

    sum + product
}
