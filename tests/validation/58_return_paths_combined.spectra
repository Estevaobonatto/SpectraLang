// Teste 58: Combinações de if/match/loop assegurando retornos válidos
module validation_return_paths

func evaluate(flag: bool, value: int) returns int {
    if flag {
        match value % 3 {
            when 0 then value,
            otherwise then value + 1,
        }
    } else {
        let temp = value
        loop {
            if temp > 5 {
                break
            }

            if temp == 5 {
                return temp * 2
            }

            temp = temp + 1
        }

        match temp > 10 {
            when true then temp,
            when false then temp + 2,
        }
    }
}

func analyze(choice: bool, depth: int) returns int {
    match choice {
        when true then {
            let mut_depth = depth + 1
            if mut_depth > 3 {
                return mut_depth * 3
            }

            loop {
                if mut_depth % 2 == 0 {
                    return mut_depth + 7
                }
                mut_depth = mut_depth + 1
            }
        },
        when false then {
            let value = depth * 2
            match value {
                when 0 then 10,
                otherwise then {
                    if value > 10 {
                        value
                    } else {
                        value + 5
                    }
                }
            }
        },
    }
}

func branch_with_unless(flag: bool, start: int) returns int {
    let counter = start

    if not flag {
        loop {
            if counter > 8 {
                return counter
            }

            match counter % 4 {
                when 0 then {
                    counter = counter + 3
                }
                otherwise then {
                    counter = counter + 2
                }
            }
        }
    }

    match flag {
        when true then start + 1,
        when false then counter,
    }
}

public func main() returns int {
    let a = evaluate( true, 4)
    let b = evaluate( false, 3)
    let c = analyze( true, 2)
    let d = analyze( false, 6)
    let e = branch_with_unless( false, 1)

    let total = a + b + c + d + e
    if total == 47 {
        0
    } else {
        total
    }
}
