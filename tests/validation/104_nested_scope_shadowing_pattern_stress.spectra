module nested_scope_shadowing_pattern_stress;

struct Boxed {
    pub value: int,
}

enum Item {
    One(int),
    Boxed { value: int },
    Empty,
}

fn inspect(item: Item, adjust: fn(int) -> int) -> int {
    return match item {
        Item::One(value) => adjust(value),
        Item::Boxed { value } => {
            let value = value + 1;
            adjust(value)
        },
        Item::Empty => 0
    };
}

pub fn main() -> int {
    let value = 10;
    let boxed = Boxed { value: value };
    let adjust: fn(int) -> int = |input: int| input + value;

    let first = inspect(Item::One(3), adjust);
    let second = inspect(Item::Boxed { value: boxed.value }, adjust);

    if first != 13 {
        return first;
    }
    if second != 21 {
        return second;
    }
    return 0;
}
