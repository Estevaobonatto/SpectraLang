// Test: Tuple variant destructuring
// Expected: Compile successfully

module test

enum Option<T> {
    Some(T),
    None
}

enum Result<T> {
    Ok(T),
    Err(T)
}

// Test básico: extrair valor simples
func test_simple() returns int {
    let opt = Option::Some(42)
    match opt {
        when Option::Some(value) then value,
        when Option::None then 0
    }
}

// Test: usar valor extraído em expressão
func test_expression() returns int {
    let opt = Option::Some(10)
    match opt {
        when Option::Some(x) then x * 2,
        when Option::None then -1
    }
}

// Test: pattern matching aninhado
func test_result() returns int {
    let res_ok  = Result::Ok(100)
    let res_err = Result::Err(-5)

    let ok_value = match res_ok {
        when Result::Ok(value) then value + 1,
        when Result::Err(code) then code * -1
    }

    let err_value = match res_err {
        when Result::Ok(value) then value,
        when Result::Err(code) then code * -1
    }

    ok_value + err_value
}

func main() returns int {
    let a = test_simple()
    // 42
    let b = test_expression()
    // 20
    let c = test_result()
    // 106

    a + b + c // 168
}
