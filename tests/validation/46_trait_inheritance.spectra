// Teste de trait inheritance
module test46

// Trait base
trait Printable {
    func to_string( & self) returns int
}

// Trait que herda de Printable
trait Debug: Printable {
    func debug( & self) returns int
}

// Struct que implementa Debug (deve implementar ambos Printable e Debug)
record Point {
    x: int,
    y: int
}

impl Debug for Point {
    func to_string( & self) returns int {
        self.x + self.y
    }

    func debug( & self) returns int {
        self.x * self.y
    }
}

func main() returns int {
    let p   = Point { x: 10, y: 20 }
    let str = p.to_string()
    // 30 (10 + 20)
    let dbg = p.debug()
    // 200 (10 * 20)
    str + dbg // 230
}
