module async_send_sync_valid;

struct NonSend {
    value: int
}

async fn ready(value: int) -> int {
    return value;
}

async fn local_value_does_not_cross_await() -> int {
    let local = NonSend { value: 20 };
    let copied = local.value;
    let after = await ready(22);
    return copied + after;
}

async fn send_values_cross_await() -> int {
    let left = 10;
    let right = await ready(32);
    return left + right;
}

fn main() -> int {
    let task = send_values_cross_await();
    return block_on(task) - 42;
}
