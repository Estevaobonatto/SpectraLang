module async_send_sync_valid

record NonSend {
    value: int
}

async func ready(value: int) returns int {
    return value
}

async func local_value_does_not_cross_await() returns int {
    let local  = NonSend { value: 20 }
    let copied = local.value
    let after  = await ready(22)
    return copied + after
}

async func send_values_cross_await() returns int {
    let left  = 10
    let right = await ready(32)
    return left + right
}

func main() returns int {
    let task = send_values_cross_await()
    return block_on(task) - 42
}
