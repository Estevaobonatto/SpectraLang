// Teste 70: Phase 3 std.tensor production core
// Cobre views, shape metadata, concat/stack, argmax e matmul batched.
module tensor_phase3_production

import std.tensor as tensor

public func main() returns int {
    tensor.free_all()

    let base       = tensor.arange(1, 7, 1)
    let matrix     = tensor.reshape(base, 2, 3)
    let transposed = tensor.transpose(matrix)

    if tensor.rank(transposed) != 2 {
        return tensor.rank(transposed)
    }
    if tensor.rows(transposed) != 3 {
        return tensor.rows(transposed)
    }
    if tensor.cols(transposed) != 2 {
        return tensor.cols(transposed)
    }
    if tensor.get2(transposed, 0, 1) != 4 {
        return tensor.get2(transposed, 0, 1)
    }

    let permuted = tensor.permute(matrix, 0, 1)
    if tensor.get2(permuted, 1, 0) != 2 {
        return tensor.get2(permuted, 1, 0)
    }

    let sliced = tensor.slice(base, 2, 5)
    if tensor.sum(sliced) != 12 {
        return tensor.sum(sliced)
    }

    let left   = tensor.arange(1, 4, 1)
    let right  = tensor.arange(4, 7, 1)
    let joined = tensor.concat(left, right)
    if tensor.len(joined) != 6 {
        return tensor.len(joined)
    }
    if tensor.argmax(joined) != 5 {
        return tensor.argmax(joined)
    }

    let row_a        = tensor.reshape(left, 1, 3)
    let row_b        = tensor.reshape(right, 1, 3)
    let stacked_rows = tensor.stack(row_a, row_b)
    if tensor.rank(stacked_rows) != 3 {
        return tensor.rank(stacked_rows)
    }
    if tensor.dim(stacked_rows, 0) != 2 {
        return tensor.dim(stacked_rows, 0)
    }

    let lhs_flat  = tensor.arange(1, 9, 1)
    let rhs_flat  = tensor.ones(8)
    let lhs2      = tensor.reshape(lhs_flat, 2, 4)
    let rhs2      = tensor.reshape(rhs_flat, 4, 2)
    let lhs_batch = tensor.stack(lhs2, lhs2)
    let rhs_batch = tensor.stack(rhs2, rhs2)
    let batched   = tensor.matmul_batched(lhs_batch, rhs_batch)

    if tensor.rank(batched) != 3 {
        return tensor.rank(batched)
    }
    if tensor.dim(batched, 0) != 2 {
        return tensor.dim(batched, 0)
    }
    if tensor.get(batched, 0) != 10 {
        return tensor.get(batched, 0)
    }

    tensor.free_all()
    return 0
}
