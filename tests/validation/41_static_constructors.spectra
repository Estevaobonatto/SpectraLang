// Teste de constructors estáticos: Type::new()
module test41

record Point {
    x: int,
    y: int
}

impl Point {
    // Constructor estático (sem self)
    func new(x: int, y: int) returns Point {
        Point { x: x, y: y }
    }

    // Método regular (com self)
    func get_x( & self) returns int {
        self.x
    }
}

func main() returns int {
    // Syntax sugar: Type::method()
    let p = Point::new(10, 20)

    // Método regular
    let x = p.get_x()

    x
}
