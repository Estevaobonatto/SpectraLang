module algorithms_number_theory

func fail(code: int) returns int {
    return code
}

func gcd(a: int, b: int) returns int {
    let x = a
    let y = b

    while y != 0 {
        let r = x % y
        x = y
        y = r
    }

    return x
}

func lcm(a: int, b: int) returns int {
    return(a / gcd(a, b)) * b
}

func fib(n: int) returns int {
    let previous = 0
    let current  = 1
    let index    = 0

    while index < n {
        let next = previous + current
        previous = current
        current = next
        index = index + 1
    }

    return previous
}

func is_prime(value: int) returns bool {
    if value < 2 {
        return false
    }

    let divisor = 2
    while divisor * divisor <= value {
        if value % divisor == 0 {
            return false
        }
        divisor = divisor + 1
    }

    return true
}

func count_primes_below(limit: int) returns int {
    let count   = 0
    let current = 0

    while current < limit {
        if is_prime(current) {
            count = count + 1
        }
        current = current + 1
    }

    return count
}

public func main() returns int {
    if gcd(1071, 462) != 21 {
        return fail(1)
    }
    if lcm(462, 1071) != 23562 {
        return fail(2)
    }
    if fib(12) != 144 {
        return fail(3)
    }
    if count_primes_below(30) != 10 {
        return fail(4)
    }
    if is_prime(221) {
        return fail(5)
    }
    return 0
}
