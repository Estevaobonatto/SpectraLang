module algorithms_number_theory;

fn fail(code: int) -> int {
    return code;
}

fn gcd(a: int, b: int) -> int {
    let x = a;
    let y = b;

    while y != 0 {
        let r = x % y;
        x = y;
        y = r;
    }

    return x;
}

fn lcm(a: int, b: int) -> int {
    return (a / gcd(a, b)) * b;
}

fn fib(n: int) -> int {
    let previous = 0;
    let current = 1;
    let index = 0;

    while index < n {
        let next = previous + current;
        previous = current;
        current = next;
        index = index + 1;
    }

    return previous;
}

fn is_prime(value: int) -> bool {
    if value < 2 {
        return false;
    }

    let divisor = 2;
    while divisor * divisor <= value {
        if value % divisor == 0 {
            return false;
        }
        divisor = divisor + 1;
    }

    return true;
}

fn count_primes_below(limit: int) -> int {
    let count = 0;
    let current = 0;

    while current < limit {
        if is_prime(current) {
            count = count + 1;
        }
        current = current + 1;
    }

    return count;
}

pub fn main() -> int {
    if gcd(1071, 462) != 21 {
        return fail(1);
    }
    if lcm(462, 1071) != 23562 {
        return fail(2);
    }
    if fib(12) != 144 {
        return fail(3);
    }
    if count_primes_below(30) != 10 {
        return fail(4);
    }
    if is_prime(221) {
        return fail(5);
    }
    return 0;
}
