module leetcode_graph_shortest_path

func edge(weights: [int], row: int, col: int) returns int {
    return weights[row * 6 + col]
}

func dijkstra_signature() returns int {
    let weights = [
        0, 7, 9, 0, 0, 14,
        7, 0, 10, 15, 0, 0,
        9, 10, 0, 11, 0, 2,
        0, 15, 11, 0, 6, 0,
        0, 0, 0, 6, 0, 9,
        14, 0, 2, 0, 9, 0
    ]
    let dist    = [0, 999, 999, 999, 999, 999]
    let visited = [0, 0, 0, 0, 0, 0]
    let step    = 0

    while step < 6 {
        let best_node = -1
        let best_dist = 1000
        let i         = 0
        while i < 6 {
            if visited[i] == 0 and dist[i] < best_dist {
                best_dist = dist[i]
                best_node = i
            }
            i = i + 1
        }

        if best_node == -1 {
            break
        }
        visited[best_node] = 1

        let neighbor = 0
        while neighbor < 6 {
            let w = edge(weights, best_node, neighbor)
            if w > 0 and visited[neighbor] == 0 {
                let candidate = dist[best_node] + w
                if candidate < dist[neighbor] {
                    dist[neighbor] = candidate
                }
            }
            neighbor = neighbor + 1
        }

        step = step + 1
    }

    return dist[0] + dist[1] * 10 + dist[2] * 100 + dist[3] * 1000 + dist[4] * 10000 + dist[5] * 100000
}

public func main() returns int {
    if dijkstra_signature() != 1320970 {
        return 1
    }
    return 0
}
