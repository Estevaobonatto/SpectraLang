// Extended validation: prefix sums and range-sum reconstruction.
module base_prefix_difference;

fn range_signature() -> int {
    let values = [3, 1, 4, 1, 5];
    let prefix = [0, 0, 0, 0, 0];
    let running = 0;
    let i = 0;
    while i < 5 {
        running = running + values[i];
        prefix[i] = running;
        i = i + 1;
    }

    let range_1_to_3 = prefix[3] - prefix[0];
    let range_0_to_4 = prefix[4];
    return range_1_to_3 * 10 + range_0_to_4;
}

pub fn main() -> int {
    if range_signature() != 74 { return 1; }
    return 0;
}
