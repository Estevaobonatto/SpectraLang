// Extended validation: concatenation and rank-raising stack composition.
module tensor_concat_stack;

import std.tensor as tensor;

pub fn main() -> int {
    tensor.free_all();
    let first = tensor.arange(1, 4, 1);
    let second = tensor.arange(4, 7, 1);
    let joined = tensor.concat(first, second);
    if tensor.len(joined) != 6 || tensor.sum(joined) != 21 { return 1; }
    if tensor.argmax(joined) != 5 { return 2; }

    let row_a = tensor.reshape(first, 1, 3);
    let row_b = tensor.reshape(second, 1, 3);
    let stacked = tensor.stack(row_a, row_b);
    if tensor.rank(stacked) != 3 { return 3; }
    if tensor.dim(stacked, 0) != 2 || tensor.dim(stacked, 1) != 1 { return 4; }
    if tensor.get(stacked, 5) != 6 { return 5; }
    tensor.free_all();
    return 0;
}
