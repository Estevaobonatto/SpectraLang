// Extended validation: tiled-free integer matrix multiplication.
module base_matrix_integer_multiply

func checksum() returns int {
    let left   = [1, 2, 3, 4, 5, 6]
    let right  = [7, 8, 9, 10, 11, 12]
    let output = [0, 0, 0, 0]
    let row    = 0
    while row < 2 {
        let col = 0
        while col < 2 {
            let inner = 0
            let total = 0
            while inner < 3 {
                total = total + left[row * 3 + inner] * right[inner * 2 + col]
                inner = inner + 1
            }
            output[row * 2 + col] = total
            col = col + 1
        }
        row = row + 1
    }
    return output[0] + output[1] + output[2] + output[3]
}

public func main() returns int {
    if checksum() != 415 { return 1
    }
    return 0
}
