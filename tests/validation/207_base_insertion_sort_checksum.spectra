// Extended validation: insertion sort, mutation and a weighted invariant.
module base_insertion_sort_checksum;

fn weighted_checksum() -> int {
    let values = [9, 1, 5, 3, 7, 2];
    let index = 1;
    while index < 6 {
        let current = values[index];
        let position = index - 1;
        while position >= 0 && values[position] > current {
            values[position + 1] = values[position];
            position = position - 1;
        }
        values[position + 1] = current;
        index = index + 1;
    }

    let checksum = 0;
    let i = 0;
    while i < 6 {
        checksum = checksum + values[i] * (i + 1);
        i = i + 1;
    }
    return checksum;
}

pub fn main() -> int {
    if weighted_checksum() != 123 { return 1; }
    return 0;
}
