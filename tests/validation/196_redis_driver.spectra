module redis_driver;

import {
    RedisConnection,
    open,
    close,
    get,
    set,
    delete,
    expire,
    incr,
    exists,
} from std.api.db.redis;

pub fn main() -> int {
    let url: string = "__SPECTRA_REDIS_URL__";
    let connection: RedisConnection = open(url);
    if set(connection, "spectra:r2507:fixture", "value") != true { return 11; }
    if get(connection, "spectra:r2507:fixture") != "value" { return 12; }
    if exists(connection, "spectra:r2507:fixture") != true { return 13; }
    if expire(connection, "spectra:r2507:fixture", 30) != true { return 14; }
    if delete(connection, "spectra:r2507:fixture") != true { return 15; }
    if incr(connection, "spectra:r2507:counter", 2) != 2 { return 16; }
    if close(connection) != true { return 17; }
    return 0;
}
