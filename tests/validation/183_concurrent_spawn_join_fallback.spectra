// R-3132: observed handles must remain on the general task path.
module concurrent_spawn_join_fallback

import std.concurrent as concurrent

public func main() returns int {
    concurrent.reset()
    let task = concurrent.task_spawn(41)
    if not concurrent.task_is_done(task) {
        return 1
    }
    let copy = task
    if concurrent.task_join(copy) != 41 {
        return 2
    }
    if concurrent.stats_tasks_spawned() != 1 {
        return 3
    }
    return 0
}
