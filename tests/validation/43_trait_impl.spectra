// Teste de trait implementation
module test43

// Declaração do trait
trait Printable {
    func println( & self) returns int
}

record Point {
    x: int,
    y: int
}

// Implementação do trait para Point
impl Printable for Point {
    func println( & self) returns int {
        self.x + self.y
    }
}

func main() returns int {
    let p = Point { x: 10, y: 20 }
    p.println()
}
