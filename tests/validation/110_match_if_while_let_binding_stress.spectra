module match_if_while_let_binding_stress;

enum Option {
    Some(int),
    None,
}

fn positive(value: int) -> Option {
    if value > 0 {
        return Option::Some(value);
    }
    return Option::None;
}

fn score(value: Option) -> int {
    return match value {
        Option::Some(n) => n * 2,
        Option::None => 0
    };
}

pub fn main() -> int {
    let total = 0;
    let current = 4;

    while let Option::Some(n) = positive(current) {
        total = total + score(Option::Some(n));
        current = current - 1;
    }

    if let Option::Some(last) = positive(3) {
        total = total + last;
    } else {
        return 1;
    }

    if total != 23 {
        return total;
    }
    return 0;
}
