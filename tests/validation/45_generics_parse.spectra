// Teste de parsing de generics com trait bounds
module test45

// Trait simples para usar como bound
trait Printable {
    func println( & self) returns int
}

// Função genérica simples sem bounds
func identity<T>(x: T) returns T {
    return x
}

// Função genérica com trait bound
func process<T: Printable>(item: T) returns int {
    return item.println()
}

// Função genérica com múltiplos type parameters
func combine<T, U>(x: T, y: U) returns int {
    return 42
}

func main() returns int {
    return 0
}
