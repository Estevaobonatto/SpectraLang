// Extended validation: breadth-first search with a queue and predecessor data.
module base_bfs_line_graph

func shortest_distance() returns int {
    let adjacency = [
        0, 1, 0, 0, 0,
        1, 0, 1, 0, 0,
        0, 1, 0, 1, 0,
        0, 0, 1, 0, 1,
        0, 0, 0, 1, 0
    ]
    let distance = [-1, -1, -1, -1, -1]
    let queue    = [0, 0, 0, 0, 0]
    let head     = 0
    let tail     = 1
    queue[0] = 0
    distance[0] = 0

    while head < tail {
        let node = queue[head]
        head = head + 1
        let next = 0
        while next < 5 {
            if adjacency[node * 5 + next] == 1 and distance[next] == -1 {
                distance[next] = distance[node] + 1
                queue[tail] = next
                tail = tail + 1
            }
            next = next + 1
        }
    }
    return distance[4] * 100 + distance[2] * 10 + tail
}

public func main() returns int {
    if shortest_distance() != 425 { return 1
    }
    return 0
}
