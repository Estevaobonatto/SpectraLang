// Teste 68: Phase 4 std.tensor kernels, transpose, dot, RNG int e métricas
module tensor_phase4_kernels;

import std.tensor as tensor;

pub fn main() -> int {
    tensor.free_all();
    tensor.reset_stats();

    let a = tensor.arange(1, 5, 1);
    let b = tensor.arange(1, 5, 1);

    if tensor.dot(a, b) != 30 {
        return tensor.dot(a, b);
    }

    let neg = tensor.neg(a);
    if tensor.get(neg, 0) != -1 {
        return tensor.get(neg, 0);
    }

    let matrix = tensor.reshape(a, 2, 2);
    let transposed = tensor.transpose(matrix);
    if tensor.get2(transposed, 0, 1) != 3 {
        return tensor.get2(transposed, 0, 1);
    }

    tensor.seed(2026);
    let r1 = tensor.uniform(8, 0, 10);
    tensor.seed(2026);
    let r2 = tensor.uniform(8, 0, 10);
    if tensor.get(r1, 0) != tensor.get(r2, 0) {
        return 41;
    }

    if tensor.stats_kernel_ops() < 4 {
        return 42;
    }
    if tensor.stats_peak_bytes() <= 0 {
        return 43;
    }

    tensor.free_all();
    return 0;
}
