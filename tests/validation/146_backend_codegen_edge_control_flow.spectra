module backend_codegen_edge_control_flow

enum Step {
    Add(int),
    Skip,
    Stop
}

func classify(index: int) returns Step {
    switch index {
        case 1: {
            return Step::Add(11)
        }
        case 2: {
            return Step::Skip
        }
        case 3: {
            return Step::Add(13)
        }
        else: {
            return Step::Stop
        }
    }
}

func accumulate(limit: int) returns int {
    let index = 0
    let total = 0

    loop {
        index = index + 1
        if index > limit {
            break
        }

        match classify(index) {
            when Step::Add(value) then {
                total = total + value
            }
            when Step::Skip then {
                continue
            }
            when Step::Stop then {
                break
            }
        }
    }

    return total
}

public func main() returns int {
    let value = accumulate(5)
    if value != 24 {
        return value
    }
    return 0
}
