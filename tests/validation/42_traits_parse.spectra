// Teste básico de traits - apenas parsing
module test42

// Declaração do trait
trait Printable {
    func println( & self) returns int
    func debug( & self) returns int
}

record Point {
    x: int,
    y: int
}

// Por enquanto, apenas testando o parse do trait
// A implementação virá depois
func main() returns int {
    42
}
