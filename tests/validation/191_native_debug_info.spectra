module native_debug_info

record DebugPoint {
    value: int,
}

func helper(value: int) returns int {
    let doubled = value * 2
    return doubled
}

public func main() {
    let input       = 21
    let result      = helper(input)
    let debug_value = result
    let point       = DebugPoint { value: debug_value }
    let count       = 0
    while count < 2 {
        count = count + 1
    }
    if point.value == 42 and count == 2 {
        return
    }
    return
}
