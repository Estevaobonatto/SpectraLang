module async_echo_batch_contract

import std.concurrent as concurrent

public func main() returns int {
    let iterations = 1000
    let total      = 0
    let i          = 0
    while i < iterations {
        concurrent.reset()
        let batch = concurrent.task_spawn_batch(1, 10)
        total = total + concurrent.task_join_batch_sum(batch)
        i = i + 1
    }
    if total == 55000 {
        return 0
    }
    return 1
}
