// Teste completo de traits com validação
module test44

trait Calculator {
    func add( & self, x: int, y: int) returns int
    func multiply( & self, x: int) returns int
    func get_value( & self) returns int
}

record MathEngine {
    value: int
}

// Implementação completa e correta
impl Calculator for MathEngine {
    func add( & self, x: int, y: int) returns int {
        x + y + self.value
    }

    func multiply( & self, x: int) returns int {
        x * 2
    }

    func get_value( & self) returns int {
        self.value
    }
}

func main() returns int {
    let engine = MathEngine { value: 5 }
    let sum    = engine.add(10, 20)
    // 35
    let product = engine.multiply(7)
    // 14
    let val = engine.get_value()
    // 5
    sum + product + val // 54
}
