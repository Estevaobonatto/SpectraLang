// Teste 16: Break e continue
module break_continue

func test_break() returns int {
    let i = 0
    while i < 100 {
        i = i + 1
        if i == 10 {
            break
        }
    }
    return i
}

func test_continue() returns int {
    let sum = 0
    let i   = 0

    while i < 10 {
        i = i + 1
        if i == 5 {
            continue
        }
        sum = sum + i
    }

    return sum
}

func main() returns int {
    let r1 = test_break()
    let r2 = test_continue()
    return r1 + r2
}
