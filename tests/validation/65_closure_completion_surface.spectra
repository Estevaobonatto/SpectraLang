// Teste 65: closures nao capturantes armazenadas, chamadas e passadas como fn(...)
module closure_completion_surface

func apply(value: int, f: func(int) returns int) returns int {
    return f(value)
}

func select(adjust: bool) returns func(int) returns int {
    if adjust {
        return | x: int | x + 10
    }
    return | x: int | x - 10
}

public func main() returns int {
    let inc: func(int) returns int = | x: int | x + 1
    let dec: func(int) returns int = | x: int | x - 1
    let chosen                     = select( true)

    let a = inc(4)
    let b = apply(10, dec)
    let c = chosen(5)

    if a != 5 {
        return a
    }
    if b != 9 {
        return b
    }
    if c != 15 {
        return c
    }

    return 0
}
