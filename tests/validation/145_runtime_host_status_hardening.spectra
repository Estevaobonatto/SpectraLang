module runtime_host_status_hardening

import std.fs as fs
import std.error as error
import std.collections as collections
import std.compat.collections as compat

public func main() returns int {
    let invalid_read = fs.fs_read("")
    if let Result::Err(read_error) = invalid_read {
        if error.code(read_error) != 0 {
            return 1
        }
    } else {
        return 1
    }
    let invalid_exists = fs.fs_exists("")
    if let Result::Err(exists_error) = invalid_exists {
        if error.code(exists_error) != 0 {
            return 2
        }
    } else {
        return 2
    }

    let released = collections.list_new()
    collections.list_free(released)
    if compat.list_get(released, 0) != -1 {
        return 3
    }
    if compat.list_pop(released) != -1 {
        return 4
    }
    if compat.list_remove_at(released, 0) != -1 {
        return 5
    }

    let values = collections.list_new()
    if compat.list_get(values, -1) != -1 {
        return 6
    }
    if compat.list_get(values, 0) != -1 {
        return 7
    }
    collections.list_free(values)

    return 0
}
