// Extended validation: enum state transitions and match destructuring.
module base_enum_state_machine

enum Machine {
    Counting { value: int },
    Done,
}

func transition(value: int) returns Machine {
    if value < 3 { return Machine::Counting { value: value + 1 }
    }
    return Machine::Done
}

func trace() returns int {
    let value = 0
    let total = 0
    let steps = 0
    while steps < 4 {
        let state = transition(value)
        match state {
            when Machine::Counting { value: next } then {
                value = next
                total = total + next
            }
            when Machine::Done then { return total * 10 + steps
            }
        }
        steps = steps + 1
    }
    return-1
}

public func main() returns int {
    if trace() != 63 { return 1
    }
    return 0
}
