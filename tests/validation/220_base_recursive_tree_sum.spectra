// Extended validation: recursive traversal over a compact binary tree.
module base_recursive_tree_sum;

fn tree_sum(node: int, values: [int], left: [int], right: [int]) -> int {
    if node < 0 { return 0; }
    return values[node] + tree_sum(left[node], values, left, right) + tree_sum(right[node], values, left, right);
}

pub fn main() -> int {
    let values = [5, 3, 8, 2, 4, 7, 9];
    let left = [1, 3, 5, -1, -1, -1, -1];
    let right = [2, 4, 6, -1, -1, -1, -1];
    if tree_sum(0, values, left, right) != 38 { return 1; }
    if tree_sum(3, values, left, right) != 2 { return 2; }
    return 0;
}
