module base_loop_break_continue_runtime;

fn nested_sum(limit: int) -> int {
    let outer = 0;
    let total = 0;

    loop {
        outer = outer + 1;
        if outer > limit {
            break;
        }

        let inner = 0;
        loop {
            inner = inner + 1;
            if inner == 2 {
                continue;
            }
            if inner > 3 {
                break;
            }
            total = total + outer * 10 + inner;
        }
    }

    return total;
}

pub fn main() -> int {
    let value = nested_sum(3);
    if value != 132 {
        return value;
    }
    return 0;
}
