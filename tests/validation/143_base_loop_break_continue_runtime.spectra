module base_loop_break_continue_runtime

func nested_sum(limit: int) returns int {
    let outer = 0
    let total = 0

    loop {
        outer = outer + 1
        if outer > limit {
            break
        }

        let inner = 0
        loop {
            inner = inner + 1
            if inner == 2 {
                continue
            }
            if inner > 3 {
                break
            }
            total = total + outer * 10 + inner
        }
    }

    return total
}

public func main() returns int {
    let value = nested_sum(3)
    if value != 132 {
        return value
    }
    return 0
}
