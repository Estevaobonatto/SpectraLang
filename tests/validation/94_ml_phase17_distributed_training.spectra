module ml_phase17_distributed_training

import std.fs as fs
import std.string as str
import std.ml as ml

public func main() returns int {
    let session = ml.distributed_session_start("reference-distributed-run", "target/r1703-run", 3, 2026)

    if ml.distributed_worker_step(session, 0, 8, 0.25) != 1 {
        return 1
    }
    if ml.distributed_worker_step(session, 1, 8, 0.50) != 1 {
        return 2
    }
    if ml.distributed_worker_step(session, 2, 8, 0.75) != 1 {
        return 3
    }
    if ml.distributed_global_step(session) != 1 {
        return 4
    }

    let checkpoint = ml.distributed_checkpoint_save(session, "target/r1703-run/checkpoint.json", 1)
    let checkpoint_result = fs.fs_read(checkpoint)
    if let Result::Ok(checkpoint_text) = checkpoint_result {
        if str.contains(checkpoint_text, "spectra.ml.distributed_checkpoint.v1") {
            let ok_checkpoint = 1
            if ok_checkpoint != 1 {
                return 5
            }
        } else {
            return 5
        }
        if str.contains(checkpoint_text, "\"interrupted_worker\":1") {
            let ok_interruption = 1
            if ok_interruption != 1 {
                return 6
            }
        } else {
            return 6
        }
    } else {
        return 5
    }

    let resumed = ml.distributed_resume(checkpoint)
    if ml.distributed_worker_step_count(resumed, 1) != 1 {
        return 7
    }
    if ml.distributed_worker_step(resumed, 0, 4, 0.10) != 2 {
        return 8
    }
    if ml.distributed_worker_step(resumed, 1, 4, 0.10) != 2 {
        return 9
    }
    if ml.distributed_worker_step(resumed, 2, 4, 0.10) != 2 {
        return 10
    }
    if ml.distributed_global_step(resumed) != 2 {
        return 11
    }

    let summary = ml.distributed_summary(resumed)
    if str.contains(summary, "single-machine-simulated-workers") {
        let ok_topology = 1
        if ok_topology != 1 {
            return 12
        }
    } else {
        return 12
    }
    if str.contains(summary, "\"total_samples\":36") {
        return 0
    }
    return 13
}
