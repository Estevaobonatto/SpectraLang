module base_pattern_match_string_runtime

func label(value: int) returns string {
    return match value {
        when 10 then "ok",
        otherwise then "bad"
    }
}

public func main() returns int {
    let result = label(10)

    if result != "ok" {
        return 2
    }

    if result == "bad" {
        return 3
    }

    match result {
        when "ok" then {
            return 0
        }
        otherwise then {
            return 1
        }
    }
}
