module async_phase21_nested_blocks

async func base(value: int) returns int {
    return value
}

async func nested(flag: bool) returns int {
    let first = await base(10)
    if flag {
        let second = await base(20)
        return first + second
    }
    let fallback = await base(3)
    return first - fallback
}

async func entry() returns int {
    let yes = await nested( true)
    let no  = await nested( false)
    return yes + no
}

func main() returns int {
    let task = entry()
    return 0
}
