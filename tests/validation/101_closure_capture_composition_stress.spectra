module closure_capture_composition_stress;

fn apply(value: int, f: fn(int) -> int) -> int {
    return f(value);
}

fn apply_pair(left: int, right: int, f: fn(int, int) -> int) -> int {
    return f(left, right);
}

fn make_shift(delta: int) -> fn(int) -> int {
    let scale = 2;
    return |value: int| value + delta * scale;
}

fn choose_shift(use_positive: bool, base: int) -> fn(int) -> int {
    if use_positive {
        return |value: int| value + base;
    }
    return |value: int| value - base;
}

pub fn main() -> int {
    let external = 5;
    let add_external: fn(int) -> int = |value: int| value + external;
    let shifted = make_shift(3);
    let chosen = choose_shift(false, 4);
    let pair_sum: fn(int, int) -> int = |left: int, right: int| left + right + external;

    let a = apply(7, add_external);
    let b = shifted(10);
    let c = apply(20, chosen);
    let d = apply_pair(1, 2, pair_sum);

    if a != 12 {
        return a;
    }
    if b != 16 {
        return b;
    }
    if c != 16 {
        return c;
    }
    if d != 8 {
        return d;
    }
    return 0;
}
