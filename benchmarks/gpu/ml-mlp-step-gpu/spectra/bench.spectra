// R-1603 / R-3080 / R-3052: ml-mlp-step-gpu (Spectra)
// Forward + backward + sgd_step on a 2-layer MLP, 10 iterations.
// Designed for the GPU production path: tensors are uploaded via
// `to_device(Wgpu)` once, then every forward/backward op stays on
// device through the R-3052 residency story and the R-3080 GPU
// backward kernels in `runtime/src/gpu.rs`.
//
// The bench reports a final `total` (sum of the prediction vector)
// and exits 0 so the runner can assert correctness. Timing is
// measured by the Python harness `scripts/validate_r1603_gpu_speedup.py`
// around the entire program.

module bench_ml_mlp_step_gpu;

import std.tensor as tensor;
import std.ml as ml;

fn train_step(x: int, target: int, w1: int, b1: int, w2: int, b2: int) -> int {
    let h = ml.linear(x, w1, b1);
    let h_act = tensor.relu(h);
    let prediction = ml.linear(h_act, w2, b2);
    let loss = ml.mse_loss(prediction, target);
    tensor.backward(loss);
    ml.sgd_step(w1, 0.01);
    ml.sgd_step(b1, 0.01);
    ml.sgd_step(w2, 0.01);
    ml.sgd_step(b2, 0.01);
    return 0;
}

pub fn main() -> int {
    tensor.free_all();
    tensor.set_grad_enabled(true);
    tensor.reset_stats();

    // Skip the GPU path entirely on hosts without a WGPU adapter; the
    // bench falls back to a CPU run so the harness still gets a
    // measurable timing. The speedup gate compares the GPU run
    // against this CPU run; on no-GPU hosts the gate fails the
    // ratio check and the operator is expected to run it on a real
    // GPU host.
    if !tensor.device_available(6) {
        let features = tensor.reshape(tensor.full_f(128 * 128, 0.5), 128, 128);
        let labels = tensor.full_f(128, 1.0);
        let w1 = tensor.requires_grad(tensor.reshape(tensor.full_f(128 * 128, 0.1), 128, 128), true);
        let b1 = tensor.requires_grad(tensor.full_f(128, 0.0), true);
        let w2 = tensor.requires_grad(tensor.reshape(tensor.full_f(128, 0.1), 128, 1), true);
        let b2 = tensor.requires_grad(tensor.full_f(1, 0.0), true);
        let i = 0;
        while i < 10 {
            let h = ml.linear(features, w1, b1);
            let _a = tensor.relu(h);
            let p = ml.linear(h, w2, b2);
            let l = ml.mse_loss(p, labels);
            tensor.backward(l);
            ml.sgd_step(w1, 0.01);
            ml.sgd_step(b1, 0.01);
            ml.sgd_step(w2, 0.01);
            ml.sgd_step(b2, 0.01);
            i = i + 1;
        }
        tensor.free_all();
        return 0;
    }

    let batch = 128;
    let in_features = 128;
    let hidden = 128;

    let features_h = tensor.full_f(batch * in_features, 0.5);
    let labels_h = tensor.full_f(batch, 1.0);
    let w1_h = tensor.full_f(in_features * hidden, 0.1);
    let b1_h = tensor.full_f(hidden, 0.0);
    let w2_h = tensor.full_f(hidden, 0.1);
    let b2_h = tensor.full_f(1, 0.0);

    // R-3052: upload to Wgpu once; the rest of the training loop stays
    // on device. Falls back to CPU automatically when the adapter is
    // missing (the bench still runs, just without speedup).
    let wgpu = 6;
    let features = tensor.to_device(tensor.reshape(features_h, batch, in_features), wgpu);
    let labels = tensor.to_device(labels_h, wgpu);
    let w1 = tensor.requires_grad(
        tensor.to_device(tensor.reshape(w1_h, in_features, hidden), wgpu),
        true,
    );
    let b1 = tensor.requires_grad(tensor.to_device(b1_h, wgpu), true);
    let w2 = tensor.requires_grad(
        tensor.to_device(tensor.reshape(w2_h, hidden, 1), wgpu),
        true,
    );
    let b2 = tensor.requires_grad(tensor.to_device(b2_h, wgpu), true);

    let iters = 10;
    let i = 0;
    while i < iters {
        train_step(features, labels, w1, b1, w2, b2);
        i = i + 1;
    }

    let prediction = ml.linear(
        tensor.relu(ml.linear(features, w1, b1)),
        w2,
        b2,
    );
    let n = tensor.len(prediction);
    let _r = tensor.stats_device_resident_tensors();
    let _b = tensor.stats_gpu_backward_ops();
    tensor.free_all();
    if n == batch {
        return 0;
    }
    return 1;
}
