// Phase 31: cpu-fibs (Spectra)
// Iterative Fibonacci(40) repeated many times.

module bench_cpu_fibs;

pub fn main() -> int {
    let iters = 200000;
    let total = 0;
    let k = 0;
    while k < iters {
        let a = 0;
        let b = 1;
        let i = 0;
        while i < 40 {
            let c = a + b;
            a = b;
            b = c;
            i = i + 1;
        }
        total = total + a;
        k = k + 1;
    }
    if total == 20466831000000 {
        return 0;
    }
    return 1;
}
