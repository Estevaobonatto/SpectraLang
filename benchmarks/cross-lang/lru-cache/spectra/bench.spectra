// Phase 31: lru-cache (Spectra)
// LRU cache with cap 16, 1000 ops: 500 hot (always hit) + 500 cold (mostly miss).
// Expected per-iter hits: 492 (computed via scripts/_compute_bench10_expected.py)
// On every get/put of an existing key, a NEW node is appended and the map is
// updated to the new nid. The old nid is orphaned. The orphan's prev/next
// pointers are not used (the map points to the new nid), so no stale data
// corrupts the list.

module bench_lru_cache;

import std.collections as col;

pub fn main() -> int {
    let iters = 1000;
    let cap = 16;
    let ops = 1000;
    // Pre-allocate enough nodes for the precompute LRU style.
    // Max unique keys per LRU = 80 (16 hot + 64 cold), plus up to ~500 new
    // nodes from get-hit relinks. 1000 is more than enough.
