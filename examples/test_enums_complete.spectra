module test

// Enum simples (unit variants)
enum Color {
    Red,
    Green,
    Blue
}

// Teste com unit variants
func test_unit_enum() returns int {
    let red   = Color::Red
    let green = Color::Green
    let blue  = Color::Blue
    // Por enquanto, apenas retornar tag do red (0)
    42
}

// Enum com dados (tuple variants)
enum Option<T> {
    Some(T),
    None
}

func test_tuple_enum() returns int {
    let some_val  = Option::Some(100)
    let none_val  = Option::None
    let extracted = match some_val {
        when Option::Some(value) then value,
        when Option::None then 0,
    }
    let fallback = match none_val {
        when Option::Some(value) then value,
        when Option::None then 5,
    }
    extracted + fallback
}

// Enum mais complexo
enum Result<T> {
    Ok(T),
    Err(T)
}

func test_result_enum() returns int {
    let ok       = Result::Ok(42)
    let err      = Result::Err(1)
    let ok_value = match ok {
        when Result::Ok(value) then value,
        when Result::Err(code) then code,
    }
    let err_value = match err {
        when Result::Ok(value) then value,
        when Result::Err(code) then code * -1,
    }
    ok_value + err_value
}

func main() returns int {
    test_unit_enum() + test_tuple_enum() + test_result_enum()
}
