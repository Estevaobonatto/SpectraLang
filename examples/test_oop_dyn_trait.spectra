// ============================================================
// OOP Test 4 — dyn Trait / Despacho Dinâmico (Phase 4)
// Testa: trait, impl Trait for T, dyn Trait, coerção com as
// ============================================================
module test_oop_dyn_trait

import std.io

// ─── Trait: Shape (geometria) ───────────────────────────────

trait Shape {
    func area( & self) returns int
    func perimeter( & self) returns int
    func name( & self) returns string
}

// ─── Circle ─────────────────────────────────────────────────

record Circle {
    public radius: int,
}

impl Circle {
    public func new(r: int) returns Circle {
        Circle { radius: r }
    }
}

impl Shape for Circle {
    func area( & self) returns int {
        // π × r² ≈ 3 × r² (inteiro aproximado)
        3 * self.radius * self.radius
    }
    func perimeter( & self) returns int {
        // 2π × r ≈ 6 × r
        6 * self.radius
    }
    func name( & self) returns string {
        "Círculo"
    }
}

// ─── Rectangle ──────────────────────────────────────────────

record Rectangle {
    public width: int,
    public height: int,
}

impl Rectangle {
    public func new(w: int, h: int) returns Rectangle {
        Rectangle { width: w, height: h }
    }
}

impl Shape for Rectangle {
    func area( & self) returns int {
        self.width * self.height
    }
    func perimeter( & self) returns int {
        2 * (self.width + self.height)
    }
    func name( & self) returns string {
        "Retângulo"
    }
}

// ─── Triangle ───────────────────────────────────────────────

record Triangle {
    public base: int,
    public height: int,
    public side_a: int,
    public side_b: int,
    public side_c: int,
}

impl Triangle {
    public func new(base: int, height: int, a: int, b: int, c: int) returns Triangle {
        Triangle { base: base, height: height, side_a: a, side_b: b, side_c: c }
    }
}

impl Shape for Triangle {
    func area( & self) returns int {
        self.base * self.height / 2
    }
    func perimeter( & self) returns int {
        self.side_a + self.side_b + self.side_c
    }
    func name( & self) returns string {
        "Triângulo"
    }
}

// ─── Função que aceita dyn Trait ────────────────────────────

func print_shape_info(shape: dyn Shape) {
    let n = shape.name()
    let a = shape.area()
    let p = shape.perimeter()
    println(f"  {n}: área={a}, perímetro={p}")
}

func total_area(s1: dyn Shape, s2: dyn Shape, s3: dyn Shape) returns int {
    s1.area() + s2.area() + s3.area()
}

// ─── Trait: Drawable (para polimorfismo diferente) ──────────

trait Drawable {
    func draw( & self) returns string
    func color( & self) returns string
}

record Sprite {
    public id: int,
    public x: int,
    public y: int,
}

impl Sprite {
    public func new(id: int, x: int, y: int) returns Sprite {
        Sprite { id: id, x: x, y: y }
    }
}

impl Drawable for Sprite {
    func draw( & self) returns string {
        f"Sprite#{self.id} em ({self.x},{self.y})"
    }
    func color( & self) returns string {
        "branco"
    }
}

record Background {
    public layer: int,
}

impl Background {
    public func new(layer: int) returns Background {
        Background { layer: layer }
    }
}

impl Drawable for Background {
    func draw( & self) returns string {
        f"Background camada {self.layer}"
    }
    func color( & self) returns string {
        "azul"
    }
}

func render(d: dyn Drawable) {
    let img = d.draw()
    let c   = d.color()
    println(f"  Renderizando: {img} [cor: {c}]")
}

public func main() returns int {
    println("=== Teste 1: Shapes via dyn Trait ===")

    let c = Circle::new(5)
    let r = Rectangle::new(4, 6)
    let t = Triangle::new(3, 4, 3, 4, 5)

    // Coerção de record para dyn Trait com 'as'
    let sc = c as dyn Shape
    let sr = r as dyn Shape
    let st = t as dyn Shape

    print_shape_info(sc)
    print_shape_info(sr)
    print_shape_info(st)

    let total = total_area(
        c as dyn Shape,
        r as dyn Shape,
        t as dyn Shape,
    )
    println(f"Área total: {total}")

    println("")
    println("=== Teste 2: Drawable via dyn Trait ===")

    let spr1 = Sprite::new(1, 10, 20)
    let spr2 = Sprite::new(2, 50, 60)
    let bg   = Background::new(0)

    render(spr1 as dyn Drawable)
    render(spr2 as dyn Drawable)
    render(bg as dyn Drawable)

    println("")
    println("=== dyn Trait funcionando corretamente ===")

    return 0
}
