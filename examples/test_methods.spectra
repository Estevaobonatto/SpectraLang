module test

record Point {
    x: int,
    y: int
}

impl Point {
    func new(x: int, y: int) returns Point {
        Point { x: x, y: y }
    }

    func distance_from_origin( & self) returns int {
        // Simplificado: apenas soma x + y
        self.x + self.y
    }

    func move_by( & mut self, dx: int, dy: int) {
        self.x = self.x + dx
        self.y = self.y + dy
    }
}

func main() returns int {
    let p    = Point::new(3, 4)
    let dist = p.distance_from_origin()
    dist // 7
}
