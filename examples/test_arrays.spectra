module test_arrays

func test_simple_array() returns int {
    let arr = [1, 2, 3, 4, 5]
    let x   = arr[2]
    x
}

func test_array_assignment() returns int {
    let arr = [10, 20, 30]
    arr[1] = 99
    arr[1]
}

func test_array_loop() returns int {
    let arr = [1, 2, 3, 4, 5]
    let sum = 0
    let i   = 0

    while i < 5 {
        sum = sum + arr[i]
        i = i + 1
    }

    sum
}
