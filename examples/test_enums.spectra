module test

// Enum simples (C-style)
enum Color {
    Red,
    Green,
    Blue
}

// Enum com valores associados
enum Option<T> {
    Some(T),
    None
}

enum Result<T> {
    Ok(T),
    Err(T)
}

func test_simple_enum() returns int {
    let c = Color::Red
    // Por enquanto, apenas retornar valor fixo
    42
}

func test_option_enum() returns int {
    let opt = Option::Some(10)
    match opt {
        when Option::Some(value) then value,
        when Option::None then 0
    }
}

func test_result_enum() returns int {
    let ok  = Result::Ok(21)
    let err = Result::Err(-4)

    let ok_value = match ok {
        when Result::Ok(value) then value,
        when Result::Err(code) then code,
    }

    let err_value = match err {
        when Result::Ok(value) then value,
        when Result::Err(code) then code * -1,
    }

    ok_value + err_value
}

func main() returns int {
    test_simple_enum() + test_option_enum() + test_result_enum()
}
