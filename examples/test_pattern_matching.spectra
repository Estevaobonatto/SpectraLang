module test

enum Option<T> {
    Some(T),
    None
}

enum Result<T> {
    Ok(T),
    Err(T)
}

// Teste básico de match
func unwrap_or(opt: Option<int>, default: int) returns int {
    match opt {
        when Option::Some(value) then value,
        when Option::None then default
    }
}

// Match com Result
func handle_result(res: Result<int>) returns int {
    match res {
        when Result::Ok(value) then value,
        when Result::Err(code) then code * -1
    }
}

// Match aninhado
func process(opt: Option<int>) returns int {
    match opt {
        when Option::Some(x) then {
            match x {
                otherwise then x + 10
            }
        },
        when Option::None then 0
    }
}

func main() returns int {
    let some_val: Option<int>  = Option::Some(42)
    let result                 = unwrap_or(some_val, 0)
    let status: Option<string> = Option::Some("ready")
    let message                = match status {
        when Option::Some(text) then text,
        when Option::None then "unknown",
    }
    let _ = message
    // Apenas para evitar warnings
    result
}
