module test

// Test: Identifier binding captura qualquer valor
func test_simple() returns int {
    let x = 42
    match x {
        when value then value + 10
    }
}

// Test: Múltiplos arms com identifiers
func test_multiple_arms() returns int {
    let x = 5
    match x {
        when first then first * 2
    }
}

// Test: Identifier com underscore ignora
func test_wildcard_vs_identifier() returns int {
    let x = 100
    match x {
        otherwise then 1,
        when y then y // Este nunca será alcançado devido ao wildcard antes
    }
}

func main() returns int {
    test_simple() // 52
}
