module test

enum Color {
    Red,
    Green,
    Blue
}

// Test: Match exhaustivo com todos os variants
func test_exhaustive_complete() returns int {
    let c = Color::Red
    match c {
        when Color::Red then 1,
        when Color::Green then 2,
        when Color::Blue then 3
    }
}

// Test: Match exhaustivo com wildcard
func test_exhaustive_wildcard() returns int {
    let c = Color::Green
    match c {
        when Color::Red then 1,
        otherwise then 99
    }
}

// Test: Match exhaustivo com identifier
func test_exhaustive_identifier() returns int {
    let c = Color::Blue
    match c {
        when x then 42
    }
}

func main() returns int {
    let a = test_exhaustive_complete()
    // 1
    let b = test_exhaustive_wildcard()
    // 99
    let c = test_exhaustive_identifier()
    // 42

    a + b + c // 142
}
