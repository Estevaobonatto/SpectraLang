module contador

from std.io import println
from std.time import monotonic_millis

public func main() returns int {
    let count  = 0
    let inicio = monotonic_millis()
    for i in 0 .. 1000000000 {
        count = count + 1
    }
    let fim = monotonic_millis()
    println(f"{count}")
    println(f"Tempo: {fim - inicio}ms")
    return 0
}
