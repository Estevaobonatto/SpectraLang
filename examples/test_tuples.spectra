module test_tuples

func test_simple_tuple() returns int {
    let tuple = (1, 2, 3)
    let x     = tuple.0
    let y     = tuple.1
    let z     = tuple.2
    x + y + z
}

func test_mixed_tuple() returns int {
    let data = (42, "hello", true)
    let num  = data.0
    num
}

func test_tuple_assignment() returns int {
    let result = (10, 20)
    let x      = result.0
    let y      = result.1
    x + y
}

func test_nested_tuple() returns int {
    let nested = ((1, 2), (3, 4))
    let first  = nested.0
    let x      = first.0
    x
}
