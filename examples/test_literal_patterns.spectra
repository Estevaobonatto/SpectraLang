module test

// Test: Match com literal int
func test_int_literal() returns int {
    let x = 42
    match x {
        when 42 then 100,
        when 0 then 200,
        otherwise then 300
    }
}

// Test: Match com literal bool
func test_bool_literal() returns int {
    let flag = true
    match flag {
        when true then 1,
        when false then 0
    }
}

// Test: Match com múltiplos literais
func test_multiple_literals() returns int {
    let x = 5
    match x {
        when 1 then 10,
        when 2 then 20,
        when 3 then 30,
        when 5 then 50,
        otherwise then 999
    }
}

// Test: Match com expressões após literal
func test_literal_with_expression() returns int {
    let x = 10
    match x {
        when 10 then x * 2,
        when 20 then x + 5,
        otherwise then 0
    }
}

func main() returns int {
    let a = test_int_literal()
    // 100
    let b = test_bool_literal()
    // 1
    let c = test_multiple_literals()
    // 50
    let d = test_literal_with_expression()
    // 20

    a + b + c + d // 171
}
