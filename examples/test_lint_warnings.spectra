module test_lint_warnings

func unused_params(x: int, y: int, z: int) returns int {
    return x
}

func unreachable_after_return() returns int {
    return 42
    let dead = 10
    return dead
}

func shadowing_example() returns int {
    let x = 10
    if true {
        let x = 20
        return x
    }
    return x
}

func main() {
    let unused_var = 100
    let result     = unused_params(1, 2, 3)
    return
}
