module test

enum Color {
    Red,
    Green,
    Blue
}

// Test: Match NÃO exhaustivo - falta Blue
func test_non_exhaustive() returns int {
    let c = Color::Red
    match c {
        when Color::Red then 1,
        when Color::Green then 2
        // Faltando Color::Blue - deveria dar warning/erro
    }
}

func main() returns int {
    test_non_exhaustive()
}
