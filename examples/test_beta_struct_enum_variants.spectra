module test_beta_struct_enum_variants

// Struct-style enum variants with named fields
enum Shape {
    Circle { radius: float },
    Rectangle { width: float, height: float },
    Triangle { base: float, height: float },
    Point,
}

func area(s: Shape) returns float {
    match s {
        when Shape::Circle { radius } then {
            return radius * radius * 3.14159
        }
        when Shape::Rectangle { width, height } then {
            return width * height
        }
        when Shape::Triangle { base, height } then {
            return base * height * 0.5
        }
        when Shape::Point then {
            return 0.0
        }
    }
}

enum Color {
    Rgb { r: int, g: int, b: int },
    Hsv { h: float, s: float, v: float },
    Named(string),
}

func describe_color(c: Color) returns string {
    match c {
        when Color::Rgb { r, g, b } then {
            return f"RGB({r}, {g}, {b})"
        }
        when Color::Hsv { h, s, v } then {
            return "HSV color"
        }
        when Color::Named(name) then {
            return name
        }
    }
}

func main() returns int {
    let circle = Shape::Circle { radius: 5.0 }
    let rect   = Shape::Rectangle { width: 4.0, height: 6.0 }
    let tri    = Shape::Triangle { base: 3.0, height: 8.0 }
    let pt     = Shape::Point

    let a1 = area(circle)
    // ~78.54
    let a2 = area(rect)
    // 24.0
    let a3 = area(tri)
    // 12.0
    let a4 = area(pt)
    // 0.0

    let red   = Color::Rgb { r: 255, g: 0, b: 0 }
    let sky   = Color::Named("sky blue")
    let desc1 = describe_color(red)
    // "RGB(255, 0, 0)"
    let desc2 = describe_color(sky)
    // "sky blue"

    return 0
}
