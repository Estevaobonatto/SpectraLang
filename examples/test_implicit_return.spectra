module test_implicit

func test_after_loop() returns int {
    let i = 0
    while i < 3 {
        i = i + 1
    }
    i // Deve funcionar como implicit return
}

func test_after_if() returns int {
    let x = 10
    if x > 5 {
        x = x + 1
    }
    x // Deve funcionar
}

func test_simple() returns int {
    let x = 42
    x // Já funciona
}
