module sa_math

public func clamp(v: int, lo: int, hi: int) returns int {
    if v < lo { return lo
    }
    if v > hi { return hi
    }
    return v
}

public func abs_val(n: int) returns int {
    if n < 0 { return 0 - n
    }
    return n
}

public func max2(a: int, b: int) returns int {
    if a >= b { return a
    }
    return b
}

public func min2(a: int, b: int) returns int {
    if a <= b { return a
    }
    return b
}

public func average4(a: int, b: int, c: int, d: int) returns int {
    return(a + b + c + d) / 4
}

public func gcd(a: int, b: int) returns int {
    let x = a
    let y = b
    while y != 0 {
        let t = y
        y = x % y
        x = t
    }
    return x
}

public func is_prime(n: int) returns bool {
    if n <= 1 { return false
    }
    if n <= 3 { return true
    }
    if n % 2 == 0 { return false
    }
    let i = 3
    while i * i <= n {
        if n % i == 0 { return false
        }
        i = i + 2
    }
    return true
}

public func fib(n: int) returns int {
    if n <= 1 { return n
    }
    let a = 0
    let b = 1
    let i = 2
    while i <= n {
        let tmp = a + b
        a = b
        b = tmp
        i = i + 1
    }
    return b
}

public func count_digits(n: int) returns int {
    if n == 0 { return 1
    }
    let num   = abs_val(n)
    let count = 0
    while num > 0 {
        count = count + 1
        num = num / 10
    }
    return count
}

public func digit_sum(n: int) returns int {
    let num = abs_val(n)
    let sum = 0
    while num > 0 {
        sum = sum + (num % 10)
        num = num / 10
    }
    return sum
}

public func pow(base: int, exp: int) returns int {
    let result = 1
    let i      = 0
    while i < exp {
        result = result * base
        i = i + 1
    }
    return result
}
