module sa_grades

public enum Grade {
    A,
    B,
    C,
    D,
    F,
}

public enum Status {
    Honors,
    Passing,
    Probation,
    Failing,
}

public func score_to_grade(score: int) returns Grade {
    if score >= 90 { return Grade::A
    }
    if score >= 80 { return Grade::B
    }
    if score >= 70 { return Grade::C
    }
    if score >= 60 { return Grade::D
    }
    return Grade::F
}

public func grade_points(g: Grade) returns int {
    match g {
        when Grade::A then 4,
        when Grade::B then 3,
        when Grade::C then 2,
        when Grade::D then 1,
        when Grade::F then 0,
    }
}

public func score_status(avg: int) returns Status {
    if avg >= 90 { return Status::Honors
    }
    if avg >= 60 { return Status::Passing
    }
    if avg >= 50 { return Status::Probation
    }
    return Status::Failing
}

public func status_points(s: Status) returns int {
    match s {
        when Status::Honors then 10,
        when Status::Passing then 5,
        when Status::Probation then 2,
        when Status::Failing then 0,
    }
}

public func grade_label(g: Grade) returns int {
    // Numeric label for display: A=4, B=3, ...
    match g {
        when Grade::A then 4,
        when Grade::B then 3,
        when Grade::C then 2,
        when Grade::D then 1,
        when Grade::F then 0,
    }
}

public func run_grades_tests() returns int {
    // score_to_grade + grade_points
    let ga = score_to_grade(95)
    // A
    let gb = score_to_grade(85)
    // B
    let gc = score_to_grade(75)
    // C
    let gd = score_to_grade(65)
    // D
    let gf = score_to_grade(55)
    // F

    let pa = grade_points(ga)
    // 4
    let pb = grade_points(gb)
    // 3
    let pc = grade_points(gc)
    // 2
    let pd = grade_points(gd)
    // 1
    let pf = grade_points(gf)
    // 0

    // score_status + status_points
    let sh = score_status(92)
    // Honors
    let sp = score_status(75)
    // Passing
    let sr = score_status(55)
    // Probation
    let sf = score_status(40)
    // Failing

    let vh = status_points(sh)
    // 10
    let vp = status_points(sp)
    // 5
    let vr = status_points(sr)
    // 2
    let vf = status_points(sf)
    // 0

    // grade_label uses match too
    let la = grade_label(ga)
    // 4
    let lb = grade_label(gb)
    // 3

    // Sum: 4+3+2+1+0+10+5+2+0+4+3 = 34
    pa + pb + pc + pd + pf + vh + vp + vr + vf + la + lb
}
