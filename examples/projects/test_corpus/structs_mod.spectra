// Structs with impl blocks, constructors, methods, and operator overloading
module structs_mod

record Vec2 {
    x: int,
    y: int
}

impl Vec2 {
    func new(x: int, y: int) returns Vec2 {
        Vec2 { x: x, y: y }
    }

    func get_x( & self) returns int {
        self.x
    }

    func get_y( & self) returns int {
        self.y
    }

    func magnitude_sq( & self) returns int {
        self.x * self.x + self.y * self.y
    }

    func scale( & self, factor: int) returns Vec2 {
        Vec2 { x: self.x * factor, y: self.y * factor }
    }

    func dot( & self, other: Vec2) returns int {
        self.x * other.x + self.y * other.y
    }

    func add( & self, other: Vec2) returns Vec2 {
        Vec2 { x: self.x + other.x, y: self.y + other.y }
    }
}

record Counter {
    value: int,
    step: int
}

impl Counter {
    func new(step: int) returns Counter {
        Counter { value: 0, step: step }
    }

    func increment( & self) returns Counter {
        Counter { value: self.value + self.step, step: self.step }
    }

    func get( & self) returns int {
        self.value
    }
}

public func run_structs_tests() returns int {
    // Vec2 constructor and getters
    let v1 = Vec2::new(3, 4)
    let x  = v1.get_x()
    // 3
    let y = v1.get_y()
    // 4
    let mag = v1.magnitude_sq()
    // 9 + 16 = 25

    // Scaling
    let v2  = v1.scale(2)
    let vx2 = v2.get_x()
    // 6
    let vy2 = v2.get_y()
    // 8

    // Dot product
    let v3  = Vec2::new(1, 2)
    let dot = v1.dot(v3)
    // 3*1 + 4*2 = 11

    // Add
    let v4 = v1.add(v3)
    let ax = v4.get_x()
    // 3+1 = 4
    let ay = v4.get_y()
    // 4+2 = 6

    // Counter
    let c  = Counter::new(5)
    let c1 = c.increment()
    // value = 5
    let c2 = c1.increment()
    // value = 10
    let cv = c2.get()
    // 10

    // Return sum: 3+4+25+6+8+11+4+6+10 = 77
    x + y + mag + vx2 + vy2 + dot + ax + ay + cv
}
