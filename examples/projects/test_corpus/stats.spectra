module stats

import mathlib

// Sum of first n integers
public func sum_n(n: int) returns int {
    let sum = 0
    let i   = 1
    while i <= n {
        sum = sum + i
        i = i + 1
    }
    return sum
}

// Count of integers in range [lo, hi]
public func range_count(lo: int, hi: int) returns int {
    if hi < lo {
        return 0
    }
    return hi - lo + 1
}

// Power: base ^ exp (integer)
public func power(base: int, exp: int) returns int {
    let result = 1
    let i      = 0
    while i < exp {
        result = result * base
        i = i + 1
    }
    return result
}

// Check if a number is even
public func is_even(n: int) returns bool {
    let r = n - (n / 2) * 2
    return r == 0
}
