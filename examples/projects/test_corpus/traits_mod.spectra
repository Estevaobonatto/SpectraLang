// Traits: declaration and implementation across multiple types
module traits_mod

trait Shape {
    func area( & self) returns int
    func perimeter( & self) returns int
    func name( & self) returns int
    // returns a code: 1=circle-like, 2=rect-like
}

trait Scalable {
    func scale( & self, factor: int) returns int
    // returns scaled area
}

record Rect {
    width: int,
    height: int
}

record Square {
    side: int
}

impl Shape for Rect {
    func area( & self) returns int {
        self.width * self.height
    }

    func perimeter( & self) returns int {
        2 * (self.width + self.height)
    }

    func name( & self) returns int {
        2
    }
}

impl Scalable for Rect {
    func scale( & self, factor: int) returns int {
        self.width * factor * self.height * factor
    }
}

impl Shape for Square {
    func area( & self) returns int {
        self.side * self.side
    }

    func perimeter( & self) returns int {
        4 * self.side
    }

    func name( & self) returns int {
        2
    }
}

impl Scalable for Square {
    func scale( & self, factor: int) returns int {
        self.side * factor * self.side * factor
    }
}

public func run_traits_tests() returns int {
    let r      = Rect { width: 5, height: 3 }
    let r_area = r.area()
    // 15
    let r_peri = r.perimeter()
    // 16
    let r_scaled = r.scale(2)
    // 5*2 * 3*2 = 60
    let r_name = r.name()
    // 2

    let s      = Square { side: 4 }
    let s_area = s.area()
    // 16
    let s_peri = s.perimeter()
    // 16
    let s_scaled = s.scale(3)
    // 4*3 * 4*3 = 144
    let s_name = s.name()
    // 2

    // Sum: 15+16+60+2+16+16+144+2 = 271
    r_area + r_peri + r_scaled + r_name + s_area + s_peri + s_scaled + s_name
}
