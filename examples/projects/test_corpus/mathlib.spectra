module mathlib

// Basic math utilities

public func square(n: int) returns int {
    return n * n
}

public func cube(n: int) returns int {
    return n * n * n
}

public func factorial(n: int) returns int {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

public func max(a: int, b: int) returns int {
    if a > b {
        return a
    }
    return b
}

public func min(a: int, b: int) returns int {
    if a < b {
        return a
    }
    return b
}

public func abs_val(n: int) returns int {
    if n < 0 {
        return n * -1
    }
    return n
}
