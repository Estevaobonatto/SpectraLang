// Enums: definition, variants, match patterns, Option/Result usage
module enums_mod

public enum Direction {
    North,
    South,
    East,
    West
}

public enum Status {
    Active(int),
    Inactive,
    Error(int)
}

public func direction_code(d: Direction) returns int {
    match d {
        when Direction::North then 1,
        when Direction::South then 2,
        when Direction::East then 3,
        when Direction::West then 4
    }
}

public func status_value(s: Status) returns int {
    match s {
        when Status::Active(v) then v,
        when Status::Inactive then 0,
        when Status::Error(e) then e * -1
    }
}

public func run_enums_tests() returns int {
    // Enum variant dispatch
    let n = direction_code(Direction::North)
    // 1
    let s = direction_code(Direction::South)
    // 2
    let e = direction_code(Direction::East)
    // 3
    let w = direction_code(Direction::West)
    // 4

    // Enums with data
    let active   = Status::Active(42)
    let inactive = Status::Inactive
    let err      = Status::Error(5)

    let av = status_value(active)
    // 42
    let iv = status_value(inactive)
    // 0
    let ev = status_value(err)
    // -5

    // Option usage
    let some_val: Option<int> = Option::Some(100)
    let none_val: Option<int> = Option::None

    let some_result = match some_val {
        when Option::Some(v) then v,
        when Option::None then 0
    }

    let none_result = match none_val {
        when Option::Some(v) then v,
        when Option::None then 99
    }

    // Sum: 1+2+3+4+42+0-5+100+99 = 246
    n + s + e + w + av + iv + ev + some_result + none_result
}
