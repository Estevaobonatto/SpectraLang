module notas

// Classificacao por conceito
public enum Conceito {
    A,
    B,
    C,
    D,
    F,
}

// Qualquer tipo que possa ser avaliado implementa este trait
public trait Avaliavel {
    func media( & self) returns int
    func aprovado( & self) returns bool
    func conceito( & self) returns Conceito
}

// Retorna o Conceito correspondente a uma media numerica
public func conceito_de_media(m: int) returns Conceito {
    if m >= 90 { return Conceito::A
    }
    else if m >= 75 { return Conceito::B
    }
    else if m >= 60 { return Conceito::C
    }
    else if m >= 50 { return Conceito::D
    }
    return Conceito::F
}

// Retorna o nome descritivo de um Conceito
public func nome_conceito(c: Conceito) returns string {
    let nome = match c {
        when Conceito::A then "A - Excelente",
        when Conceito::B then "B - Bom",
        when Conceito::C then "C - Regular",
        when Conceito::D then "D - Insuficiente",
        when Conceito::F then "F - Reprovado",
    }
    return nome
}

// Retorna a pontuacao em escala 0-10 para um Conceito
public func pontos_conceito(c: Conceito) returns int {
    let pts = match c {
        when Conceito::A then 10,
        when Conceito::B then 8,
        when Conceito::C then 6,
        when Conceito::D then 4,
        when Conceito::F then 0,
    }
    return pts
}
