module string_utils

public func repeat_str(s: string, n: int) returns string {
    let out = ""
    let i   = 0
    while i < n {
        out = out + s
        i = i + 1
    }
    return out
}

public func join_two(a: string, b: string, sep: string) returns string {
    return a + sep + b
}

public func join_three(a: string, b: string, c: string, sep: string) returns string {
    return a + sep + b + sep + c
}

public func shout(s: string) returns string {
    return s + "!!!"
}

public func greet(name: string) returns string {
    return "Hello, " + name + "!"
}

public func reverse_pair(a: string, b: string) returns(string, string) {
    return(b, a)
}
