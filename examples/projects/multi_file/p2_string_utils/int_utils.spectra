module int_utils

public func repeat_int(v: int, n: int) returns int {
    let total = 0
    let i     = 0
    while i < n {
        total = total + v
        i = i + 1
    }
    return total
}

public func gcd(a: int, b: int) returns int {
    let x = a
    let y = b
    while y != 0 {
        let r = x - (x / y) * y
        x = y
        y = r
    }
    return x
}

public func sum_range(lo: int, hi: int) returns int {
    let total = 0
    let i     = lo
    while i <= hi {
        total = total + i
        i = i + 1
    }
    return total
}
