module counter

public record Counter {
    public value: int,
    public step: int
}

public func counter_new(step: int) returns Counter {
    return Counter { value: 0, step: step }
}

public func counter_tick(c: Counter) returns Counter {
    return Counter { value: c.value + c.step, step: c.step }
}

public func counter_read(c: Counter) returns int {
    return c.value
}
