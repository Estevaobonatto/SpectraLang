module calc;

pub fn add(a: int, b: int) -> int {
    return a + b;
}

pub fn sub(a: int, b: int) -> int {
    return a - b;
}

pub fn mul(a: int, b: int) -> int {
    return a * b;
}

pub fn div(a: int, b: int) -> int {
    if b == 0 {
        return 0;
    }
    return a / b;
}

pub fn power(base: int, exp: int) -> int {
    let result = 1;
    let i = 0;
    while i < exp {
        result = result * base;
        i = i + 1;
    }
    return result;
}

pub fn abs_val(n: int) -> int {
    if n < 0 {
        return n * -1;
    }
    return n;
}

pub fn clamp(n: int, lo: int, hi: int) -> int {
    if n < lo {
        return lo;
    }
    if n > hi {
        return hi;
    }
    return n;
}
