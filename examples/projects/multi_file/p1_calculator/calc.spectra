module calc

public func add(a: int, b: int) returns int {
    return a + b
}

public func sub(a: int, b: int) returns int {
    return a - b
}

public func mul(a: int, b: int) returns int {
    return a * b
}

public func div(a: int, b: int) returns int {
    if b == 0 {
        return 0
    }
    return a / b
}

public func power(base: int, exp: int) returns int {
    let result = 1
    let i      = 0
    while i < exp {
        result = result * base
        i = i + 1
    }
    return result
}

public func abs_val(n: int) returns int {
    if n < 0 {
        return n * -1
    }
    return n
}

public func clamp(n: int, lo: int, hi: int) returns int {
    if n < lo {
        return lo
    }
    if n > hi {
        return hi
    }
    return n
}
