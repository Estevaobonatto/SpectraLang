module ledger

public func total_value(price: int, stock: int) returns int {
    return price * stock
}

public func apply_sell(stock: int, qty: int) returns int {
    let new_stock = stock - qty
    if new_stock < 0 {
        new_stock = 0
    }
    return new_stock
}

public func discount_price(price: int, pct: int) returns int {
    return price - (price * pct / 100)
}
