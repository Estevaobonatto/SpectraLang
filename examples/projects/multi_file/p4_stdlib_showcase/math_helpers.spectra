module math_helpers

import std.math as m

public func clamp_int(n: int, lo: int, hi: int) returns int {
    return m.clamp(n, lo, hi)
}

public func gcd_two(a: int, b: int) returns int {
    return m.gcd(a, b)
}

public func lcm_two(a: int, b: int) returns int {
    return m.lcm(a, b)
}

public func abs_int(n: int) returns int {
    return m.abs(n)
}

public func sign_of(n: int) returns int {
    return m.sign(n)
}
