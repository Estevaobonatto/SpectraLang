module cx_ledger

public enum TxKind {
    Credit(int),
    Debit(int),
    Transfer(int),
}

public enum AccountStatus {
    Active,
    Frozen,
    Closed,
}

public record Account {
    id: int,
    balance: int,
}

impl Account {
    public func get_balance( & self) returns int {
        return self.balance
    }
}

public func make_account(id: int, balance: int) returns Account {
    return Account { id: id, balance: balance }
}

public func account_balance(a: Account) returns int {
    return a.get_balance()
}

// Returns the magnitude of the transaction amount
public func tx_amount(t: TxKind) returns int {
    match t {
        when TxKind::Credit(amt) then { return amt
        }
        when TxKind::Debit(amt) then { return amt
        }
        when TxKind::Transfer(amt) then { return amt
        }
    }
}

// Applies a transaction to a balance and returns the new balance
public func apply_tx(balance: int, t: TxKind) returns int {
    match t {
        when TxKind::Credit(amt) then { return balance + amt
        }
        when TxKind::Debit(amt) then { return balance - amt
        }
        when TxKind::Transfer(amt) then { return balance - amt
        }
    }
}

// Returns a numeric code for an account status
public func status_code(s: AccountStatus) returns int {
    match s {
        when AccountStatus::Active then { return 1
        }
        when AccountStatus::Frozen then { return 2
        }
        when AccountStatus::Closed then { return 0
        }
    }
}
