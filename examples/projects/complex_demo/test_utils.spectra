module test_utils

public enum Status {
    Ok(int),
    Err(string),
}

public record Point {
    x: int,
    y: int,
}

public func make_point(x: int, y: int) returns Point {
    return Point { x: x, y: y }
}

public func status_value(s: Status) returns int {
    match s {
        when Status::Ok(v) then { return v
        }
        when Status::Err(_) then { return 0 - 1
        }
    }
}
