module data_types

enum Status {
    Active { code: int },
    Inactive,
    Error { code: int, message: string },
}

enum Maybe {
    Just(int),
    Nothing,
}

enum Outcome {
    Success(int),
    Failure(string),
}

func status_code(s: Status) returns int {
    match s {
        when Status::Active { code } then {
            return code
        }
        when Status::Inactive then {
            return 0
        }
        when Status::Error { code, message } then {
            return code
        }
    }
}

func maybe_double(m: Maybe) returns Maybe {
    match m {
        when Maybe::Just(n) then {
            return Maybe::Just(n * 2)
        }
        when Maybe::Nothing then {
            return Maybe::Nothing
        }
    }
}

func outcome_value(o: Outcome) returns int {
    match o {
        when Outcome::Success(v) then {
            return v
        }
        when Outcome::Failure(msg) then {
            return-1
        }
    }
}

func safe_divide(a: int, b: int) returns Maybe {
    if b == 0 {
        return Maybe::Nothing
    }
    return Maybe::Just(a / b)
}

public func test_status_codes() returns int {
    let s1 = Status::Active { code: 200 }
    let s2 = Status::Inactive
    let s3 = Status::Error { code: 404, message: "not found" }
    return status_code(s1) + status_code(s2) + status_code(s3)
}

public func test_maybe() returns int {
    let m1 = Maybe::Just(21)
    let m2 = safe_divide(100, 4)
    let m3 = safe_divide(10, 0)
    let d1 = maybe_double(m1)
    let d2 = maybe_double(m2)
    let d3 = maybe_double(m3)
    return 0
}

public func test_outcome() returns int {
    let o1 = Outcome::Success(42)
    let o2 = Outcome::Failure("error")
    return outcome_value(o1) + outcome_value(o2)
}
