module math_utils

public func distance(ax: int, ay: int, bx: int, by: int) returns int {
    let dx = ax - bx
    let dy = ay - by
    return dx * dx + dy * dy
}

public func factorial(n: int) returns int {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

public func gcd(a: int, b: int) returns int {
    if b == 0 {
        return a
    }
    return gcd(b, a % b)
}

public func circle_area(radius: int) returns int {
    return radius * radius * 3
}

public func rect_area(w: int, h: int) returns int {
    return w * h
}
