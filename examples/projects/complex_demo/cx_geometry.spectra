module cx_geometry

public enum Shape {
    Circle(int),
    Rect(int, int),
    Dot,
}

public record Vec2 {
    x: int,
    y: int,
}

impl Vec2 {
    public func len_sq( & self) returns int {
        return self.x * self.x + self.y * self.y
    }
}

public func make_vec2(x: int, y: int) returns Vec2 {
    return Vec2 { x: x, y: y }
}

public func vec2_len_sq(v: Vec2) returns int {
    return v.len_sq()
}

// area: Circle(r)=r*r*3, Rect(w,h)=w*h, Dot=0
public func shape_area(s: Shape) returns int {
    match s {
        when Shape::Circle(r) then { return r * r * 3
        }
        when Shape::Rect(w, h) then { return w * h
        }
        when Shape::Dot then { return 0
        }
    }
}

// perimeter: Circle(r)=r*6, Rect(w,h)=2*(w+h), Dot=0
public func shape_perimeter(s: Shape) returns int {
    match s {
        when Shape::Circle(r) then { return r * 6
        }
        when Shape::Rect(w, h) then { return 2 * (w + h)
        }
        when Shape::Dot then { return 0
        }
    }
}
