module test_structs

record Point {
    x: int,
    y: int
}

record Person {
    age: int,
    height: int
}

func test_basic_struct() returns int {
    let p = Point { x: 10, y: 20 }
    p.x + p.y
}

func test_multiple_structs() returns int {
    let point  = Point { x: 5, y: 15 }
    let person = Person { age: 25, height: 180 }
    point.x + person.age
}

func main() returns int {
    test_basic_struct()
}
