// AI reference example: toy transformer-style inference primitives.
module ai_toy_transformer_inference;

import std.tensor as tensor;
import std.serve as serve;
import std.fs as fs;

pub fn main() -> int {
    tensor.free_all();
    tensor.set_grad_enabled(false);
    serve.reset();

    let query = tensor.arange(1, 5, 1);
    let key = tensor.arange(1, 5, 1);
    let value = tensor.reshape(tensor.full_f(4, 2.0), 2, 2);
    let projection = tensor.reshape(tensor.full_f(4, 1.0), 2, 2);

    if tensor.dot(query, key) != 30 {
        return 1;
    }

    let projected = tensor.matmul(value, projection);
    if tensor.rows(projected) != 2 {
        return 2;
    }
    if tensor.cols(projected) != 2 {
        return 3;
    }

    let activated = tensor.relu(projected);
    if tensor.len(activated) != 4 {
        return 4;
    }

    let server = serve.server_new(3);
    serve.server_warmup(server);
    let request = serve.server_enqueue(server, 14);
    serve.server_process_batch(server, 1);
    if serve.server_result(server, request) != 42 {
        return 5;
    }

    fs.fs_write("target/ai-examples/toy_transformer_inference.txt", "spectralang toy transformer inference\nattention_score=30\nserver_result=42\n");

    tensor.free_all();
    tensor.set_grad_enabled(true);
    return 0;
}
