module test

enum Option {
    Some,
    None
}

enum Color {
    Red,
    Green,
    Blue
}

func test_simple_match() returns int {
    let c = Color::Green
    match c {
        when Color::Red then 1,
        when Color::Green then 2,
        when Color::Blue then 3
    }
}

func test_wildcard() returns int {
    let c = Color::Blue
    match c {
        when Color::Red then 1,
        otherwise then 999
    }
}

func main() returns int {
    let a = test_simple_match()
    let b = test_wildcard()
    a + b
}
