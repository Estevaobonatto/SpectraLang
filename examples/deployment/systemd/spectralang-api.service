[Unit]
Description=SpectraLang API service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spectralang
WorkingDirectory=/srv/spectralang-api
ExecStart=/usr/local/bin/spectralang run /srv/spectralang-api/app.spectra
ExecStartPost=/usr/bin/curl --fail --silent --show-error --max-time 5 http://127.0.0.1:8080/startupz
Restart=on-failure
RestartSec=2s
TimeoutStartSec=60s
TimeoutStopSec=30s
# Keep disabled until the service emits real sd_notify watchdog heartbeats.
WatchdogSec=0

[Install]
WantedBy=multi-user.target
