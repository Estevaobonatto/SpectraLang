module test

enum Option<T> {
    Some(T),
    None
}

func test_destructuring() returns int {
    let opt = Option::Some(42)
    match opt {
        when Option::Some(value) then value,
        when Option::None then 0
    }
}

func test_multiple_values() returns int {
    // Para quando tivermos tuple variants com múltiplos valores
    let x = 10
    match x {
        otherwise then x
    }
}

func test_string_destructuring() returns string {
    let msg = Option::Some("hello")
    match msg {
        when Option::Some(text) then text,
        when Option::None then "fallback"
    }
}

func main() returns int {
    let _greeting = test_string_destructuring()
    test_destructuring()
}
