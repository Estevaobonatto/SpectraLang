    "prefix": "newfile",
    "body": [
      "module ${1:name}",
      "",
      "public func main() returns int {",
      "    ${0}",
      "}"
    ],
    "description": "New Spectra file with module and main"
  },
  "Main Function": {
    "prefix": "main",
    "body": [
      "public func main() returns int {",
      "    ${0}",
      "}"
    ],
